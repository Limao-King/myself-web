---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../site.config';
import { totalGameCount } from '../data/games';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const docs = await getCollection('docs');
const feature = projects.find((p) => p.data.featured) ?? projects[0];
// 任务日志：按开始日期从新到旧排（缺省退回 date）
const fmtYm = (d?: Date) => (d ? `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}` : '');
const otherProjects = projects
  .filter((p) => p.id !== feature?.id)
  .sort((a, b) => (b.data.start ?? b.data.date).valueOf() - (a.data.start ?? a.data.date).valueOf());
const bvMatch = feature?.data.videoUrl?.match(/BV[0-9A-Za-z]{10}/);
const playerUrl = bvMatch ? `https://player.bilibili.com/player.html?bvid=${bvMatch[0]}&page=1&high_quality=1&danmaku=0&autoplay=0` : null;
const pickDoc = (id: string) => docs.find((d) => d.id === id);
const featureDocs = ['bg3', 'fairytale-plan', 'world-regions'].map((id) => pickDoc(id)).filter((d): d is NonNullable<typeof d> => Boolean(d));

const abilities = [
  { name: '系统设计', ev: '「系统策划案」发挥了效果！→', href: '/docs/fairytale-plan/', value: 86, kind: 'hp' },
  { name: '叙事设计', ev: '「世界观 · 剧本 · 对白」发挥了效果！→', href: '/docs/', value: 82, kind: 'hp' },
  { name: '关卡设计', ev: '「游戏的阅历」发挥了效果！→', href: '/game-history/', value: 78, kind: 'pp' },
];
---

<Layout panel={false} theme="eb">
  <!-- 遭遇战开场 -->
  <div id="eb-encounter" class="eb-encounter" role="dialog" aria-modal="true" aria-labelledby="eb-encounter-title">
    <p id="eb-encounter-title" class="eb-encounter__line">求职的大学生 出现了！</p>
    <button id="eb-start" type="button" class="eb-start">▶ PRESS START</button>
  </div>

  <div class="home-flow flex flex-col gap-7">
    <!-- Hero：先用招聘方最关心的定位、能力与证据建立第一印象 -->
    <section class="eb-window home-hero">
      <div class="home-hero__content">
        <p class="home-eyebrow"><span class="home-eyebrow__dot" aria-hidden="true"></span>2027 届 · 寻找游戏策划实习 / 校招机会</p>
        <p class="eb-pixel home-greeting">你好，我是 {siteConfig.name}。</p>
        <h1 class="eb-title">把想象变成设计，<br /><span>再让它落地成可玩的游戏。</span></h1>
        <p class="eb-body home-lead">{siteConfig.hero.tagline}</p>
        <ul class="home-proof" aria-label="个人经历摘要">
          <li><strong>4</strong><span>个项目</span></li>
          <li><strong>1</strong><span>款可玩 Demo</span></li>
          <li><strong>6000+</strong><span>小时游戏体验</span></li>
        </ul>
        <div class="home-actions mt-6 flex flex-wrap gap-3">
          <a href={`/projects/${feature?.id}/`} class="eb-btn-solid">查看代表项目</a>
          <a href={siteConfig.resumeUrl} target="_blank" rel="noopener" class="eb-btn-line">下载简历</a>
          <a href={`mailto:${siteConfig.email}`} class="home-text-link">联系我</a>
        </div>
      </div>
      <aside class="home-docs" aria-label="精品文档">
        <div class="home-docs__stack">
          {
            featureDocs.map((d, i) => (
              <a
                href={`/docs/${d.id}/`}
                class:list={['home-doc', `home-doc--${i + 1}`]}
                aria-label={d.data.title}
              >
                <span class="home-doc__em">{d.data.category ?? '文档'}</span>
                <strong class="home-doc__title">{d.data.title}</strong>
                <span class="home-doc__sum">{d.data.summary}</span>
                <span class="home-doc__cta">阅读 <b aria-hidden="true">→</b></span>
              </a>
            ))
          }
        </div>
      </aside>
    </section>

    <!-- 能力：角色状态栏 -->
    <section class="eb-window">
      <h2 class="eb-window__title">◆ 明鑫 的状态栏</h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-3">
        {abilities.map((a) => (
          <a href={a.href} class="eb-stat block">
            <div class="flex items-baseline justify-between">
              <span class="eb-stat__name">{a.name}</span>
              <span class="eb-stat__num">{a.value}</span>
            </div>
            <div class="eb-stat__bar" aria-hidden="true"><span class={`eb-stat__fill ${a.kind}`} style={`width:${a.value}%`}></span></div>
            <span class="eb-ev">{a.ev}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 代表项目：像素电视机 -->
    {
      feature && (
        <section class="eb-tv">
          <div class="eb-tv__top">
            <span class="eb-tv__brand px">童话冒险 DEMO</span>
            <span id="eb-tv-power" class="eb-tv__power" aria-hidden="true"></span>
          </div>
          <div class="eb-tv__screen">
            <div class="eb-tv__inner">
              <div id="eb-battle-swap" class="eb-swap">
                <div class="eb-swap__pane is-active" data-slot="play">
                  <!-- 雪花屏：电视开机未调台画面（点击开始 → 直启游戏，无中间封面） -->
                  <div class="eb-tv__static" data-cover>
                    <canvas class="eb-cover-warp" id="eb-cover-warp" aria-hidden="true"></canvas>
                    <button id="eb-play-launch" type="button" class="eb-tv__play px" aria-label="开始试玩">▶</button>
                  </div>
                  <!-- 游戏本体：仅点击后挂 src（惰性，避免首屏加载 40MB） -->
                  <div class="eb-swap__game" data-game hidden>
                    <p class="eb-swap__loading" aria-hidden="true">正在召唤试玩…</p>
                    <iframe data-src="https://play.limao.site/" title="童话冒险 DEMO 在线试玩" class="eb-video" allow="autoplay; fullscreen; gamepad"></iframe>
                  </div>
                </div>
                {
                  playerUrl && (
                    <div class="eb-battle__video eb-swap__pane" data-slot="video">
                      <p class="eb-swap__loading" aria-hidden="true">正在召唤演示视频…</p>
                      <iframe data-src={playerUrl} title="童话冒险 DEMO 演示视频" class="eb-video" allow="fullscreen; accelerometer; encrypted-media; picture-in-picture"></iframe>
                    </div>
                  )
                }
                <div class="eb-swap__flash" aria-hidden="true"></div>
              </div>
            </div>
          </div>
          <div class="eb-tv__controls">
            <p class="eb-tv__dialog px">野生的 可玩 Demo 跳了出来！—— 要做些什么呢？</p>
            {
              (playerUrl || feature.data.demoUrl) && (
                <div class="eb-hint mt-3" id="eb-hint">
                  <a href={`/projects/${feature.id}/`} class="eb-btn-line eb-hint__project" data-slot-active="play">查看完整项目</a>
                  <span class="eb-hint__sep" aria-hidden="true">/</span>
                  <a
                    id="eb-play-cta"
                    class="eb-btn-solid eb-play-main"
                    href="https://play.limao.site/"
                    target="_blank"
                    rel="noopener"
                    data-slot-active="play"
                  >
                    ▶ 直接打一场试试
                  </a>
                  {
                    playerUrl && (
                      <>
                        <span class="eb-hint__sep" aria-hidden="true">/</span>
                        <button id="eb-video-toggle" type="button" class="eb-btn-line eb-hint__watch" data-slot-active="play">
                          观看演示视频
                        </button>
                      </>
                    )
                  }
                </div>
              )
            }
          </div>
        </section>
      )
    }

    <!-- 其他项目：任务日志 -->
    <section class="eb-window">
      <h2 class="eb-window__title">◆ 任务日志（其他项目）</h2>
      <div class="mt-3 space-y-3">
        {otherProjects.map((p) => (
          <a href={`/projects/${p.id}/`} class="eb-log-row">
            <span class="eb-body">{p.data.title}</span>
            <span class="eb-log-right">
              <span class="eb-ev">{p.data.type} · {p.data.role}</span>
              <span class="eb-log-date">{fmtYm(p.data.start ?? p.data.date)}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- 代表策划文档：图鉴 -->
    <section class="eb-window">
      <h2 class="eb-window__title">◆ 图鉴（代表策划文档）</h2>
      <p class="eb-pixel mt-1 text-sm">剧本文档收集度 <span id="eb-collect">0</span>/5</p>
      <div class="mt-3 space-y-3">
        {featureDocs.map((d) => (
          <a href={`/docs/${d.id}/`} class="eb-log-row eb-log-row--doc">
            <span class="eb-body">
              <span class="eb-chip">{d.data.category}</span>
              <span class="home-log-title">{d.data.title}</span>
            </span>
            <span class="eb-ev">查看 →</span>
          </a>
        ))}
      </div>
      <div class="mt-4"><a href="/docs/" class="eb-more-link">打开完整图鉴 →</a></div>
    </section>

    <!-- 游戏经历：冒险记录 -->
    <section class="eb-window">
      <h2 class="eb-window__title">◆ 至今的冒险（游戏经历）</h2>
      <p class="eb-dialog mt-2 home-experience">已收集 <span class="eb-pixel">{totalGameCount}</span> 款游戏、累计 6000+ 小时。不只于体验，我会保持思考。在回合制游戏中思考地形利用、行动经济与构筑博弈。在叙事驱动游戏中考察结构、人物、世界观和冲突设计。优秀的游戏设计会进入我的灵感库，成为我设计时的辅助。</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {['回合制', '叙事驱动', '机制创新', '剧情结构','行动经济'].map((t) => (
          <span class="rounded px-2 py-1 text-xs" style="background:#1f140d;color:var(--eb-frame)">{t}</span>
        ))}
      </div>
      <div class="mt-4"><a href="/game-history/" class="eb-more-link">查看更多经历 →</a></div>
    </section>

    <!-- CTA：入队事件 -->
    <section class="eb-window">
      <p class="eb-dialog text-center">要让 明鑫 加入队伍吗？</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href={siteConfig.resumeUrl} target="_blank" class="eb-btn-solid">▶ 要（下载简历）</a>
        <button id="eb-no" type="button" class="eb-btn-line">不要</button>
        <a href={`mailto:${siteConfig.email}`} class="eb-btn-line">直接联系</a>
      </div>
      <p id="eb-no-msg" class="eb-dialog mt-3 text-center" hidden>……真是遗憾呢。（那就看看项目吧 → <a href="/projects/" class="eb-link">任务日志</a>）</p>
    </section>
  </div>
</Layout>

<style>
  .home-flow { padding-block: .25rem 1rem; }
  .home-hero { display:grid; grid-template-columns:minmax(0,1fr) 15rem; gap:2.5rem; align-items:stretch; padding:clamp(2rem,5vw,3.6rem); overflow:hidden; }
  .home-hero::after { content:""; position:absolute; width:18rem; height:18rem; right:-7rem; top:-9rem; border-radius:50%; border:2px solid rgba(120,80,40,.14); box-shadow:0 0 0 2rem rgba(120,80,40,.035),0 0 0 5rem rgba(120,80,40,.025); pointer-events:none; }
  .home-hero__content { position:relative; z-index:1; }
  .home-eyebrow { display:flex; align-items:center; gap:.55rem; color:#50643b; font-size:.78rem; font-weight:700; letter-spacing:.06em; margin-bottom:1.35rem; }
  .home-eyebrow__dot { width:.55rem; height:.55rem; background:#5f913d; border:2px solid #26311d; border-radius:50%; box-shadow:0 0 0 3px rgba(95,145,61,.16); }
  .home-greeting { margin-bottom:.25rem; }
  .home-hero .eb-title { font-size:clamp(2.25rem,5.5vw,4.35rem); line-height:1.08; max-width:13em; letter-spacing:-.025em; text-wrap:balance; }
  .home-hero .eb-title span { color:#9b472c; }
  .home-lead { max-width:46rem; margin-top:1.35rem; font-size:1rem; line-height:1.9; color:#514535; }
  .home-proof { display:flex; flex-wrap:wrap; margin-top:1.75rem; }
  .home-proof li { display:flex; flex-direction:column; min-width:7.5rem; padding:0 1.35rem; border-left:1px solid rgba(42,26,18,.18); }
  .home-proof li:first-child { padding-left:0; border-left:0; }
  .home-proof strong { font-family:"FusionPixel",var(--font-sans); color:#262016; font-size:1.45rem; line-height:1; }
  .home-proof span { margin-top:.4rem; color:#6a5b45; font-size:.72rem; }
  .home-actions { align-items:center; }
  .home-text-link { min-height:44px; display:inline-flex; align-items:center; padding-inline:.65rem; color:#74411f; font-size:.85rem; font-weight:700; text-decoration:underline; text-underline-offset:.3em; }
  /* 精品文档：折叠票据堆（3 张层叠错开，悬停抽出，点击跳转） */
  /* 精品文档：三张修长卡片折叠成一叠（上下交叠露边，悬停抽出，点击跳转） */
  .home-docs {
    position:relative; z-index:1; align-self:stretch; display:flex; flex-direction:column;
    padding:.25rem 0; justify-content:stretch;
  }
  /* 纸条叠：相对定位，纸条绝对定位，从顶部开始叠 */
  .home-docs__stack { position:relative; flex:1; min-height:23rem; }
  /* 每张纸条：撑满宽度的修长卡片，叠放露顶边+左右边；沿一条轻微弧线排布；颜色逐张变化 */
  .home-doc {
    position:absolute; left:0.5rem; right:0.5rem; top:0; height:82%; display:flex; flex-direction:column; gap:.5rem;
    padding:1.25rem 1.25rem 1rem; border-radius:8px; cursor:pointer; text-decoration:none;
    border:3px solid var(--doc-edge); outline:2px solid var(--doc-outline);
    background:var(--doc-bg); color:var(--doc-ink); box-shadow:5px 5px 0 rgba(24,20,16,.2);
    transform:translateX(var(--arc-x,0px)) rotate(var(--r,0deg));
    transition:transform .32s cubic-bezier(.2,1,.3,1), box-shadow .3s;
  }
  /* 三张叠放：前卡最低、后卡渐高（每张头部露出来，标题可见），沿弧线左右蜿蜒 */
  .home-doc--1 { --r:.5deg;   top:calc(16%); --arc-x:2.2rem;  z-index:3; }   /* 前：偏右（过轴右侧） */
  .home-doc--2 { --r:0deg;    top:calc(8%);  --arc-x:-2.8rem; z-index:2; }   /* 中：弧线凸向左（过轴左侧） */
  .home-doc--3 { --r:-0.5deg; top:calc(0%);  --arc-x:0.5rem;  z-index:1; }   /* 后：回摆到轴右 */
  /* 逐张换色：深绿 → 米金Beige → 暖米纸（协调于全站色板） */
  .home-doc--1 {
    --doc-bg:#27341f; --doc-ink:#f8f4dc; --doc-edge:#f8f4dc; --doc-outline:#1b2117;
    --doc-em:#a9b98a; --doc-cta:#e0c98a; --doc-sum:#c9d4ae;
  }
  .home-doc--2 {
    --doc-bg:#f5f5dc; --doc-ink:#3a2a10; --doc-edge:#3a2a10; --doc-outline:#262016;
    --doc-em:#6b4f1c; --doc-cta:#74411f; --doc-sum:#6a5b3e;
  }
  .home-doc--3 {
    --doc-bg:#f6efdb; --doc-ink:#2b2418; --doc-edge:#262016; --doc-outline:#262016;
    --doc-em:#9b472c; --doc-cta:#74411f; --doc-sum:#6a5b3e;
  }
  /* 悬停：抽出当前卡片，浮起 */
  .home-doc:hover { transform:rotate(0deg) translateY(-14px) scale(1.02); z-index:9; box-shadow:9px 13px 0 rgba(24,20,16,.22); }
  .home-doc__em { font-family:"FusionPixel",var(--font-sans); font-size:.72rem; letter-spacing:.12em; color:var(--doc-em); }
  .home-doc__title { font-size:1rem; font-weight:800; line-height:1.4; color:var(--doc-ink); display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  /* 摘要：填满卡片中段，顺便让招聘方多看到一句内容 */
  .home-doc__sum { font-size:.72rem; line-height:1.55; color:var(--doc-sum); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .home-doc__cta { margin-top:auto; padding-top:.4rem; color:var(--doc-cta); font-size:.74rem; font-weight:700; }
  .home-experience { max-width:46rem; }
  /* 图鉴条目：分类 chip 独占一行（块级），标题不再被顶出参差缩进 */
  .eb-log-row--doc .eb-body { display:flex; flex-direction:column; align-items:flex-start; gap:.35rem; min-width:0; }
  .home-log-title { overflow-wrap:anywhere; }
  .eb-chip { border-radius:4px; padding:.12rem .5rem; font-size:.68rem; letter-spacing:.05em; background:#1f140d; color:var(--eb-frame); }
  /* 面板级"更多"入口：与条目级"查看 →"链接拉开层级 */
  .home-flow .eb-more-link { margin-top:1rem; }
  @media (max-width:760px) {
    .home-flow { gap:1.25rem; }
    .home-hero { grid-template-columns:1fr; gap:1.5rem; padding:1.75rem 1.55rem; }
    .home-hero .eb-title { font-size:clamp(2rem,10vw,3rem); }
    .home-lead { font-size:.92rem; line-height:1.8; }
    .home-hero__quest { display:none; }
    .home-docs { display:flex; margin-top:.5rem; }
    /* 移动端：三张精品文档垂直紧凑列表，整体缩到约50%（更小巧） */
    .home-docs__stack { display:flex; flex-direction:column; gap:.4rem; min-height:0; flex:0 0 auto; }
    .home-doc {
      position:static; height:auto; width:100%; left:auto; right:auto;
      transform:none; padding:.5rem .55rem .45rem; gap:.15rem;
    }
    .home-doc--1,.home-doc--2,.home-doc--3 { top:auto; transform:none; }
    .home-doc:hover { transform:none; box-shadow:5px 5px 0 rgba(24,20,16,.2); }
    .home-doc__em { font-size:.5rem; letter-spacing:.08em; }
    .home-doc__title { font-size:.72rem; -webkit-line-clamp:2; }
    .home-doc__sum { font-size:.58rem; line-height:1.4; -webkit-line-clamp:2; }
    .home-doc__cta { font-size:.6rem; padding-top:.2rem; }
    .home-proof { display:grid; grid-template-columns:repeat(3,1fr); }
    .home-proof li { min-width:0; padding-inline:.75rem; }
    .home-proof strong { font-size:1.15rem; }
    .home-proof span { font-size:.64rem; white-space:nowrap; }  /* 标签不再拆出孤字（如"小时游戏体/验"） */
    .home-actions > * { flex:1 1 auto; }
    .home-text-link { justify-content:center; flex-basis:100%; }
    .home-eyebrow { font-size:.72rem; letter-spacing:.02em; white-space:nowrap; }  /* "校招机会"不拆行 */
  }
</style>

<script>
  // 遭遇战开场：只在首次真正进入站点时出现一次，之后不再出现。
  // 用 initEncounter() + astro:after-swap 处理客户端平滑导航（点「首页」等）：
  // 否则切换后覆盖层被重新注入却没有移除/绑定逻辑，会卡住整个首页。
  function initEncounter() {
    let el = document.getElementById('eb-encounter');
    let seen = false;
    try { seen = localStorage.getItem('eb-seen') === '1'; } catch {}
    const skip = seen || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    if (el && skip) { el.remove(); el = null; }
    const start = el && document.getElementById('eb-start');
    if (el && start && !start.dataset.bound) {
      start.dataset.bound = '1';
      let dismissed = false;
      let timer;
      const onKey = (event) => {
        if (event.key === 'Enter' || event.key === ' ' || event.key === 'Escape') dismiss();
      };
      const dismiss = () => {
        if (dismissed) return;
        dismissed = true;
        clearTimeout(timer);
        document.removeEventListener('keydown', onKey);
        el.classList.add('is-leaving');
        try { localStorage.setItem('eb-seen', '1'); } catch {}
        setTimeout(() => el.remove(), 700);
      };
      start.addEventListener('click', dismiss, { once: true });
      document.addEventListener('keydown', onKey);
      timer = setTimeout(dismiss, 3000);
      start.focus();
    }
  }
  initEncounter();
  document.addEventListener('astro:after-swap', initEncounter);

  // 「不要」反馈：与遭遇战同理，每次页面注入后都要重新绑定（ClientRouter 切回首页会生成新 DOM）
  function bindNoBtn() {
    const noBtn = document.getElementById('eb-no');
    const noMsg = document.getElementById('eb-no-msg');
    if (noBtn && noMsg && !noBtn.dataset.bound) {
      noBtn.dataset.bound = '1';
      noBtn.addEventListener('click', () => { noMsg.hidden = false; noBtn.disabled = true; });
    }
  }
  bindNoBtn();
  document.addEventListener('astro:after-swap', bindNoBtn);

  // BOSS 战：每次 ClientRouter 回到首页都初始化新 DOM；离开前主动销毁媒体与监听。
  function initBattleMedia() {
    const swapBox = document.getElementById('eb-battle-swap');
    const videoTog = document.getElementById('eb-video-toggle');
    const playLaunch = document.getElementById('eb-play-launch');
    const hintBox = document.getElementById('eb-hint');
    const playCta = document.getElementById('eb-play-cta');
    if (!swapBox || swapBox.dataset.bound || !(videoTog || playLaunch)) return;
    swapBox.dataset.bound = '1';
    const controller = new AbortController();
    const { signal } = controller;
    {
    const video = swapBox.querySelector('[data-slot="video"]');
    const play = swapBox.querySelector('[data-slot="play"]');
    const cover = play?.querySelector('[data-cover]');
    const gameWrap = play?.querySelector('[data-game]');
    const videoIframe = video?.querySelector('iframe');
    const playIframe = gameWrap?.querySelector('iframe');
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let busy = false;
    let started = false; // 游戏是否启动过（惰性：首次点封面才挂 src）

    // 把某个 iframe 的 src 拆掉 → 内嵌的 video/audio 元素随 DOM 一并销毁，音频必停
    const kill = (f) => { if (f) f.removeAttribute('src'); };
    const pauseGodot = (f) => { try { f?.contentWindow?.postMessage({ type: 'pause' }, '*'); } catch {} };

    // 启动游戏（惰性触发）：隐藏封面，显示游戏层并挂 src
    const launch = () => {
      if (started) return;
      started = true;
      // 电视电源灯：开播 → 红变绿
      const power = document.getElementById('eb-tv-power');
      if (power) power.classList.add('is-on');
      if (playIframe && !playIframe.src) playIframe.src = 'https://play.limao.site/';
      if (cover) cover.style.display = 'none';
      if (gameWrap) gameWrap.hidden = false;
    };

    // 切换到试玩/视频态。离开试玩即销毁实例；返回时停在封面，必须再次主动点击才加载。
    // 这样既不会后台残留音乐，也不会因「返回」动作自动创建新的 Godot 音频上下文。
    const showSlot = (slot) => {
      if (slot === 'video') {
        kill(playIframe);
        started = false;
        if (gameWrap) gameWrap.hidden = true;
        document.getElementById('eb-tv-power')?.classList.remove('is-on');
      } else {
        kill(videoIframe);
      }
      video?.classList.remove('is-active');
      play?.classList.remove('is-active');
      if (slot === 'video') {
        // 切到视频：隐藏雪花屏封面，避免视频缓冲/加载期底下雪花透出或闪现
        if (cover) cover.style.display = 'none';
        if (videoIframe && !videoIframe.src) videoIframe.src = videoIframe.dataset.src;
        video?.classList.add('is-active');
      } else {
        play?.classList.add('is-active');
        if (cover) cover.style.display = '';
        if (gameWrap) gameWrap.hidden = true;
      }
      // 视频态：隐藏主 CTA 与查看完整项目 + 只留返回
      const isVideo = slot === 'video';
      if (playCta) playCta.style.display = isVideo ? 'none' : '';
      const project = document.querySelector('.eb-hint__project');
      if (project) project.style.display = isVideo ? 'none' : '';
      if (hintBox) hintBox.classList.toggle('is-video', isVideo);
      if (videoTog) videoTog.innerHTML = isVideo
        ? '<span class="eb-hint__back" aria-hidden="true"><span class="eb-hint__back-line"></span><span class="eb-hint__back-tip"></span></span>返回'
        : '观看演示视频';
    };

    // 惰性封面点击（含启动按钮）→ 启动游戏
    cover?.addEventListener('click', launch, { signal });
    // 视频切换：视频态点它回试玩态，试玩态点它进视频态
    videoTog?.addEventListener('click', () => {
      if (busy) return;
      busy = true;
      const target = video?.classList.contains('is-active') ? 'play' : 'video';
      const run = () => { showSlot(target); busy = false; };
      if (reduce) run();
      else {
        swapBox.classList.add('is-swapping');
        setTimeout(run, 140);
        setTimeout(() => { swapBox.classList.remove('is-swapping'); busy = false; }, 400);
      }
    }, { signal });

    // 离开页面/切经典视图时也清掉音频
    const killAll = () => { kill(videoIframe); kill(playIframe); };
    const onVisibility = () => { if (document.hidden) killAll(); };
    window.addEventListener('pagehide', killAll, { signal });
    document.addEventListener('visibilitychange', onVisibility, { signal });
    const classicObserver = new MutationObserver(() => {
      if (document.documentElement.classList.contains('eb-classic')) killAll();
    });
    classicObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    const interval = window.setInterval(() => {
      if (videoIframe?.src && video?.classList.contains('is-active')) pauseGodot(videoIframe);
    }, 800);
    document.addEventListener('astro:before-swap', () => {
      killAll();
      window.clearInterval(interval);
      classicObserver.disconnect();
      controller.abort();
    }, { once: true, signal });
    }
  }
  initBattleMedia();
  document.addEventListener('astro:after-swap', initBattleMedia);

  // ============ 雪花屏（老电视未调台画面）：低分辨率随机噪点 + 扫描扰动 ============
  // 替代原正弦纹样预览面：作为试玩的前置画面，点击后直启游戏（无中间封面）。
  // 注意：必须是可重入的 initCoverWarp()（IIFE 只跑一次）——ClientRouter 软导航回到首页时
  // canvas 是全新 DOM 节点，不重新绑定的话雪花屏会变成一块空白，这就是"偶尔不显示"的根因。
  function initCoverWarp() {
    const warp = document.getElementById('eb-cover-warp');
    if (!warp || !('getContext' in warp)) return;
    if (warp._bound) return;
    warp._bound = true;

    const ctx = warp.getContext('2d');
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const controller = new AbortController();
    const { signal } = controller;
    let raf = 0;
    let started = false;
    let last = 0;

    // 电视雪花用低分辨率再放大：天然像素噪点，效果接近 CRT 雪花
    let W = 0, H = 0;
    const resize = () => {
      const box = warp.getBoundingClientRect();
      const cols = Math.max(48, Math.min(96, Math.round(box.width / 8)));
      const rows = Math.max(30, Math.min(60, Math.round(box.height / 8)));
      warp.width = cols;
      warp.height = rows;
      W = cols; H = rows;
    };
    resize();
    window.addEventListener('resize', resize, { signal });
    // CSS 拉伸像素化显示（warp 元素铺满屏幕区域）
    warp.style.width = '100%';
    warp.style.height = '100%';
    warp.style.imageRendering = 'pixelated';

    // 首帧铺满噪点；后续帧只扰动一部分像素，避免"全屏爆闪"，更像电视雪花在"沙沙"地动
    let noiseSeed = null;
    const drawStatic = () => {
      if (!noiseSeed) {
        // 首帧/尺寸变化：全屏随机
        noiseSeed = ctx.createImageData(W, H);
      }
      const d = noiseSeed.data;
      // 每帧只重绘约 55% 像素（其余保留上一帧），视觉上是持续的雪花扰动而非爆闪
      for (let i = 0; i < d.length; i += 4) {
        if (Math.random() < 0.55) {
          const v = Math.random() * 255;
          d[i] = v; d[i+1] = v; d[i+2] = v; d[i+3] = 255;
        }
      }
      // 模拟行滚动干扰：随机几行整体偏暗（像扫描线不稳）
      for (let y = 0; y < H; y += 2) {
        if (Math.random() > 0.8) {
          const rowStart = y * W * 4;
          for (let x = 0; x < W * 4; x++) d[rowStart + x] = d[rowStart + x] * 0.35;
        }
      }
      ctx.putImageData(noiseSeed, 0, 0);
    };

    // 节流：原 ~55ms/帧，再放慢 30% → ~78ms/帧，雪花"沙沙"更缓，接近真实电视而非闪屏
    const tick = (t) => {
      if (t - last >= 78) {
        drawStatic();
        last = t;
      }
      if (!reduce) raf = requestAnimationFrame(tick);
    };
    if (reduce) drawStatic();
    else { started = true; raf = requestAnimationFrame(tick); }

    // 页面隐藏时停顿，回来再续
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(raf); started = false; }
      else if (!reduce && !started && warp.isConnected && !warp.hidden) { started = true; raf = requestAnimationFrame(tick); }
    }, { signal });

    // ClientRouter 换页前清理：resize / visibilitychange 监听随旧 canvas 一起作废
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true, signal });
  }
  initCoverWarp();
  document.addEventListener('astro:after-swap', initCoverWarp);
</script>
