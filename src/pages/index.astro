---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { caseNotes } from '../data/case-notes';
import TownMap from '../components/TownMap.astro';
import BattleBackdrop from '../components/BattleBackdrop.astro';
import '../styles/home-media.css';
import '../styles/home-scenes.css';
import '../styles/town.css';
import '../styles/home-journey.css';

const projects = await getCollection('projects');
const feature = projects.find((p) => p.id === 'fairytale-demo');
const videoBvid = feature?.data.videoUrl?.match(/\/video\/(BV[\da-zA-Z]+)/)?.[1];
const videoEmbedUrl = videoBvid ? `https://player.bilibili.com/player.html?bvid=${videoBvid}&danmaku=0` : undefined;
// The cards carry only a title, a symbol and their kind; detail lives in the case.
const pokerCards = [
  { title: '童话冒险', type: '可玩原型', href: '/projects/fairytale-demo/', suit: '/images/poker/poker-suit-choice.svg' },
  { title: '死亡搁浅', type: '拆解案', href: '/docs/death-stranding/', suit: '/images/poker/poker-suit-connection.svg' },
  { title: '上元古界', type: '世界与任务', href: '/projects/gujie/', suit: '/images/poker/poker-suit-compass.svg' },
  { title: '唤她真名', type: '叙事剧本', href: '/projects/huanzhenming/', suit: '/images/poker/poker-suit-double-face.svg' },
];
const selectedWorks = [
  { id: 'fairytale-demo', title: '童话冒险', image: '/images/projects/fairytale/04-distance.jpg', alt: '童话冒险的距离机制战斗画面', label: '可玩原型' },
  { id: 'gujie', title: '上元古界', image: '/images/projects/gujie/overview.jpg', alt: '上元古界的黎稷城场景', label: '世界与任务' },
  { id: 'huanzhenming', title: '唤她真名', image: '/images/projects/huanzhenming/mba.jpg', alt: '唤她真名的幻想之城概念美术', label: '动画剧本' },
].filter((work) => projects.some((project) => project.id === work.id));
---

<Layout description="明鑫的游戏系统策划作品集：可玩原型、项目案例与策划文档。">
  <div class="pf-container pf-home">
    <div class="pf-home-scene" data-home-scene="intro" data-scene-label="出发">
    <section class="pf-hero" aria-labelledby="hero-title">
      <div class="pf-hero__copy">
        <div class="pf-hero__identity"><span>明鑫 · 游戏系统策划</span></div>
        <h1 id="hero-title">想象世界，<br /><span>改造世界。</span></h1>
        <p class="pf-hero__lead">擅长把想象变成完善的设计，<br />再让它落地成可玩的游戏。</p>
        <div class="pf-actions">
          <a href="#home-play" class="pf-button pf-button--primary">打一场？ <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="pf-poker" data-poker role="group" aria-label="冒险扑克作品牌" tabindex="0">
        <div class="pf-poker__stage" data-poker-swipe>
          {pokerCards.map((card, i) => <article class="pf-poker-card" data-poker-face data-index={i} data-suit={i + 1} data-active={i === 0} data-stack-slot={['front', 'next', 'opposite', 'prev'][i]} data-mobile-slot={i === 0 ? 'front' : ['mid-near', 'mid-far', 'back'][i - 1]} aria-label={`第 ${String(i + 1).padStart(2, '0')} 张：${card.title}`}>
            <button class="pf-poker-card__face" type="button" data-poker-select={i} data-href={card.href} data-num={String(i + 1).padStart(2, '0')} aria-label={`打开或选择《${card.title}》：${card.type}`} aria-pressed={i === 0}>
              <span class="pf-poker-card__body"><span class="pf-poker-card__symbol"><img src={card.suit} alt="" loading={i === 0 ? 'eager' : 'lazy'} /></span><span class="pf-poker-card__name"><span class="pf-poker-card__name-main">{card.title}</span></span><span class="pf-poker-card__type">{card.type}</span></span>
              <span class="pf-poker-card__sheen" aria-hidden="true"></span>
            </button>
            <span class="pf-poker-card__corner pf-poker-card__corner--tl" aria-hidden="true"><b>{String(i + 1).padStart(2, '0')}</b><img src={card.suit} alt="" loading="lazy" /></span>
            <span class="pf-poker-card__corner pf-poker-card__corner--br" aria-hidden="true"><b>{String(i + 1).padStart(2, '0')}</b><img src={card.suit} alt="" loading="lazy" /></span>
            <span class="pf-poker-card__enter" aria-hidden="true">↗</span>
          </article>)}
        </div>
        <div class="pf-poker__controls"><button type="button" data-poker-prev aria-label="上一张作品牌">←</button><span data-poker-counter aria-live="polite">01 / 04</span><button type="button" data-poker-next aria-label="下一张作品牌">→</button></div>
      </div>
    </section>
    </div>



    {feature && <div id="home-play" class="pf-home-scene pf-home-scene--play" data-home-scene="play" data-scene-label="打一场？"><div class="pf-home-play-scene">
    <div class="pf-town-crossing">
      <span class="pf-town-crossing__seam" data-street-seam aria-hidden="true"><img src="/images/scenes/street-seam.svg" alt="" width="1184" height="88" loading="lazy" /></span>
    </div>

    <section class="pf-home-play" aria-labelledby="home-play-title">
      <div class="pf-home-play__intro"><p class="pf-overline">街角电视</p><h2 id="home-play-title">打一场？</h2><img class="pf-scene-art pf-scene-art--street" src="/images/scenes/street-audience.svg" alt="" aria-hidden="true" /></div>
      <div class="pf-home-tv" data-home-play>
        <div class="pf-home-tv__top"><span>童话冒险 · 媒体频道</span><i aria-hidden="true"></i></div>
        <div class="pf-home-tv__channels" role="group" aria-label="选择体验频道"><button type="button" data-home-channel="game" aria-pressed="true">试玩游戏</button>{videoEmbedUrl && <button type="button" data-home-channel="video" aria-pressed="false">观看演示</button>}</div>
        <div class="pf-home-tv__screen" data-home-game-screen><div data-home-poster><BattleBackdrop variant="game" /></div><button class="pf-media-start" type="button" data-home-start aria-label="开始试玩《童话冒险》"><img src="/images/scenes/play.svg" alt="" width="64" height="72" /></button><p data-home-loading role="status" hidden>正在载入游戏，请稍候……</p><iframe title="童话冒险在线试玩" data-home-frame data-src="https://play.limao.site/" allow="autoplay; fullscreen; gamepad" hidden></iframe></div>
        {videoEmbedUrl && <div class="pf-home-tv__screen" data-home-video-screen hidden><div data-home-video-poster><BattleBackdrop variant="video" /></div><button class="pf-media-start" type="button" data-home-video-start aria-label="播放《童话冒险》演示视频"><img src="/images/scenes/play.svg" alt="" width="64" height="72" /></button><iframe title="童话冒险演示视频（哔哩哔哩）" data-home-video-frame data-src={videoEmbedUrl} allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" hidden></iframe></div>}

        <details class="pf-home-tv__help" data-home-help hidden><summary>画面没出来？</summary><div><p>嵌入的游戏载入可能受网络影响。</p><button type="button" data-home-retry>重新载入游戏</button></div></details>
        <div class="pf-home-tv__bottom"><a data-home-game-link href="https://play.limao.site/" target="_blank" rel="noopener noreferrer">新窗口试玩 ↗</a>{feature.data.videoUrl && <a data-home-video-fallback href={feature.data.videoUrl} target="_blank" rel="noopener noreferrer" hidden>在 B 站观看 ↗</a>}</div>
      </div>
    </section>
    </div></div>}

    <div id="works" class="pf-home-scene" data-home-scene="works" data-scene-label="作品橱窗">
    <section class="pf-selected" aria-labelledby="selected-title">
      <div class="pf-selected__heading"><h2 id="selected-title">作品橱窗</h2><a class="pf-text-link" href="/projects/">更多</a></div>
      <div class="pf-selected__grid">
        {selectedWorks.map((work, i) => <a class:list={['pf-work', i === 0 && 'pf-work--featured']} href={`/projects/${work.id}/`}>
          <div class="pf-work__image"><img src={work.image} alt={work.alt} loading="lazy" decoding="async" /><span class="pf-work__number" aria-hidden="true">0{i + 1}</span></div>
          <div class="pf-work__body"><p class="pf-work__label">{work.label}</p><h3>{work.title}</h3><div class="pf-work__bottom"><span>{caseNotes[work.id].status}</span><strong aria-label="查看案例"><span aria-hidden="true">↗</span></strong></div></div>
        </a>)}
      </div>
      <a class="pf-selected__note" href="/docs/fairytale-plan/"><span aria-hidden="true">✎</span><span>《童话冒险》手稿</span><span aria-hidden="true">→</span></a>
    </section>
    </div>



    <div id="town" class="pf-home-scene pf-home-scene--town" data-home-scene="town" data-scene-label="随便走走"><TownMap /></div>
  </div>
  <nav class="pf-scene-nav" aria-label="首页章节" data-scene-nav hidden>
    {['首页', '打一场？', '作品橱窗', '随便走走'].map((label, i) => <button type="button" data-scene-go={i} data-label={label} aria-label={`前往${label}`}><span aria-hidden="true"></span></button>)}
  </nav>
</Layout>

<script>
  import { initHomeJourney } from '../scripts/home-journey';
  initHomeJourney();
</script>

<script>
  const deck = document.querySelector('[data-poker]');
  if (deck) {
    const cards = Array.from(deck.querySelectorAll('[data-poker-face]')) as HTMLElement[];
    const selectors = Array.from(deck.querySelectorAll('[data-poker-select]')) as HTMLButtonElement[];
    let activeIndex = 0;
    const show = (index: number) => {
      activeIndex = (index + cards.length) % cards.length;
      const resting = cards.map((_, i) => i).filter((i) => i !== activeIndex);
      const prevIndex = (activeIndex + cards.length - 1) % cards.length;
      const nextIndex = (activeIndex + 1) % cards.length;
      const oppositeIndex = (activeIndex + 2) % cards.length;
      cards.forEach((card, i) => {
        card.dataset.active = String(i === activeIndex);
        card.dataset.stackSlot = i === activeIndex ? 'front' : i === prevIndex ? 'prev' : i === nextIndex ? 'next' : 'opposite';
        card.dataset.mobileSlot = i === activeIndex ? 'front' : ['mid-near', 'mid-far', 'back'][resting.indexOf(i)];
        const button = card.querySelector('[data-poker-select]');
        button?.setAttribute('aria-pressed', String(i === activeIndex));
      });
      const counter = deck.querySelector('[data-poker-counter]');
      if (counter) counter.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
    };
    deck.querySelector('[data-poker-prev]')?.addEventListener('click', () => show(activeIndex - 1));
    deck.querySelector('[data-poker-next]')?.addEventListener('click', () => show(activeIndex + 1));
    const isTouchLayout = window.matchMedia('(hover: none), (max-width: 720px)');
    selectors.forEach((button, i) => button.addEventListener('click', (event) => {
      if (isTouchLayout.matches) {
        event.preventDefault();
        // v4.13：手机端「先选后进」——点后牌先选中，再点已选中的牌直接进入
        //（入口不再依赖常驻 ↗ 徽记，牌面保持干净）。
        if (i !== activeIndex) show(i);
        else window.location.assign(button.dataset.href ?? '');
        return;
      }
      const href = button.dataset.href;
      if (href) window.location.assign(href);
    }));
    deck.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      if (event.key === 'ArrowLeft') { show(activeIndex - 1); event.preventDefault(); }
      if (event.key === 'ArrowRight') { show(activeIndex + 1); event.preventDefault(); }
    });
    const swipeArea = deck.querySelector('[data-poker-swipe]');
    let pointerStartX = 0;
    let pointerStartY = 0;
    let pointerDown = false;
    let activePointerId: number | null = null;
    let suppressClickUntil = 0;
    const resetPointer = () => {
      pointerDown = false;
      activePointerId = null;
    };
    swipeArea?.addEventListener('pointerdown', (event) => {
      if (!(event instanceof PointerEvent) || !event.isPrimary || pointerDown || (event.pointerType === 'mouse' && event.button !== 0)) return;
      pointerStartX = event.clientX;
      pointerStartY = event.clientY;
      pointerDown = true;
      activePointerId = event.pointerId;
    });
    window.addEventListener('pointerup', (event) => {
      if (!(event instanceof PointerEvent) || !pointerDown || event.pointerId !== activePointerId) return;
      const dx = event.clientX - pointerStartX;
      const dy = event.clientY - pointerStartY;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.25) {
        show(activeIndex + (dx < 0 ? 1 : -1));
        suppressClickUntil = Date.now() + 350;
      }
      resetPointer();
    });
    window.addEventListener('pointercancel', (event) => {
      if (event instanceof PointerEvent && event.pointerId === activePointerId) resetPointer();
    });
    window.addEventListener('blur', resetPointer);
    swipeArea?.addEventListener('click', (event) => {
      if (Date.now() >= suppressClickUntil) return;
      event.preventDefault();
      event.stopPropagation();
    }, true);
    show(0);
  }

  const play = document.querySelector('[data-home-play]');
  const gameFrame = play?.querySelector('[data-home-frame]');
  const gameScreen = play?.querySelector('[data-home-game-screen]');
  const gamePoster = play?.querySelector('[data-home-poster]');
  const gameStart = play?.querySelector('[data-home-start]');
  const loading = play?.querySelector('[data-home-loading]');
  const gameLink = play?.querySelector('[data-home-game-link]');
  const help = play?.querySelector('[data-home-help]');
  const videoFrame = play?.querySelector('[data-home-video-frame]');
  const videoScreen = play?.querySelector('[data-home-video-screen]');
  const videoPoster = play?.querySelector('[data-home-video-poster]');
  const videoStart = play?.querySelector('[data-home-video-start]');
  const videoFallback = play?.querySelector('[data-home-video-fallback]');
  const channels = Array.from(play?.querySelectorAll('[data-home-channel]') ?? []);
  let activeChannel = 'game';
  const setChannelState = (channel: string) => {
    activeChannel = channel;
    channels.forEach((button) => button.setAttribute('aria-pressed', String(button.getAttribute('data-home-channel') === channel)));
  };
  const releaseGame = () => {
    if (gameFrame instanceof HTMLIFrameElement) { gameFrame.removeAttribute('src'); gameFrame.hidden = true; }
    if (gamePoster instanceof HTMLElement) gamePoster.hidden = false;
    if (gameStart instanceof HTMLElement) gameStart.hidden = false;
    if (loading instanceof HTMLElement) loading.hidden = true;
    if (help instanceof HTMLDetailsElement) { help.hidden = true; help.open = false; }
  };
  const releaseVideo = () => {
    if (videoFrame instanceof HTMLIFrameElement) { videoFrame.removeAttribute('src'); videoFrame.hidden = true; }
    if (videoPoster instanceof HTMLElement) videoPoster.hidden = false;
    if (videoStart instanceof HTMLElement) videoStart.hidden = false;
  };
  channels.forEach((button) => button.addEventListener('click', () => {
    const channel = button.getAttribute('data-home-channel');
    if (!channel || channel === activeChannel) return;
    if (channel === 'video') {
      releaseGame();
      if (gameScreen instanceof HTMLElement) gameScreen.hidden = true;
      if (videoScreen instanceof HTMLElement) videoScreen.hidden = false;
      if (videoFallback instanceof HTMLElement) videoFallback.hidden = false;
      if (gameLink instanceof HTMLElement) gameLink.hidden = true;
      releaseVideo();
    } else {
      releaseVideo();
      if (videoScreen instanceof HTMLElement) videoScreen.hidden = true;
      if (videoFallback instanceof HTMLElement) videoFallback.hidden = true;
      if (gameLink instanceof HTMLElement) gameLink.hidden = false;
      if (gameScreen instanceof HTMLElement) gameScreen.hidden = false;
      releaseGame();
    }
    setChannelState(channel);
  }));
  play?.querySelector('[data-home-start]')?.addEventListener('click', () => {
    if (!(gameFrame instanceof HTMLIFrameElement) || activeChannel !== 'game') return;
    if (gamePoster instanceof HTMLElement) gamePoster.hidden = true;
    if (gameStart instanceof HTMLElement) gameStart.hidden = true;
    if (help instanceof HTMLElement) help.hidden = false;
    if (loading instanceof HTMLElement) loading.hidden = false;
    gameFrame.hidden = false;
    gameFrame.addEventListener('load', () => {
      if (loading instanceof HTMLElement) loading.hidden = true;
      }, { once: true });
    gameFrame.src = gameFrame.dataset.src || '';
  });
  play?.querySelector('[data-home-retry]')?.addEventListener('click', () => {
    if (!(gameFrame instanceof HTMLIFrameElement) || activeChannel !== 'game') return;
    gameFrame.removeAttribute('src');
    gameFrame.hidden = true;
    if (gamePoster instanceof HTMLElement) gamePoster.hidden = false;
    if (loading instanceof HTMLElement) loading.hidden = true;
    window.requestAnimationFrame(() => {
      if (!(gameFrame instanceof HTMLIFrameElement) || activeChannel !== 'game') return;
      if (gamePoster instanceof HTMLElement) gamePoster.hidden = true;
      if (loading instanceof HTMLElement) loading.hidden = false;
        gameFrame.addEventListener('load', () => {
        if (loading instanceof HTMLElement) loading.hidden = true;
          }, { once: true });
      gameFrame.hidden = false;
      gameFrame.src = gameFrame.dataset.src || '';
    });
  });
  play?.querySelector('[data-home-video-start]')?.addEventListener('click', () => {
    if (!(videoFrame instanceof HTMLIFrameElement) || activeChannel !== 'video') return;
    if (videoPoster instanceof HTMLElement) videoPoster.hidden = true;
    if (videoStart instanceof HTMLElement) videoStart.hidden = true;
    videoFrame.hidden = false;
    videoFrame.src = videoFrame.dataset.src || '';
  });
</script>

<script>
  // 街缘带「落座」微动：首次滚入视口时加一次 is-seated（2 帧 steps、≤180ms、只播一次）。
  // 独立于牌堆/媒体逻辑；无 JS 时街缘带保持静态，不影响布局与可点区。
  // 旧的 Reveal 组件与 .reveal 样式在 v3.0 重构后已无消费者（无人添加 is-revealed / .js），故此处只补最小 observer。
  const streetSeam = document.querySelector('[data-street-seam]');
  if (streetSeam && 'IntersectionObserver' in window) {
    const seatObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-seated');
        seatObserver.disconnect();
      }
    }, { threshold: 0, rootMargin: '0px 0px -48px 0px' });
    seatObserver.observe(streetSeam);
  }

</script>

<script>
  // 选牌光效：data-active 变化时对新选中的牌播一次扫光＋入口徽记脉冲（初始选中也播一次，示意可点）
  const pokerStage = document.querySelector('[data-poker-swipe]');
  if (pokerStage && 'MutationObserver' in window) {
    const glintObserver = new MutationObserver((records) => {
      for (const record of records) {
        const card = record.target;
        if (!(card instanceof HTMLElement) || card.getAttribute('data-active') !== 'true') continue;
        card.classList.remove('is-glint');
        void card.offsetWidth; // 重启动画，连点两张时也能各播一次
        card.classList.add('is-glint');
        window.setTimeout(() => card.classList.remove('is-glint'), 1200);
      }
    });
    pokerStage.querySelectorAll('[data-poker-face]').forEach((card) => glintObserver.observe(card, { attributes: true, attributeFilter: ['data-active'] }));
    // v4.14.2：删除「初始选中牌补播一次闪示」——用户实测刚进首页红牌默认发光观感像 bug；
    // 闪示只保留在真正的选牌变化（点击/方向键/轻扫）上，初始 show(0) 不再触发。
  }
</script>
