---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在">
  <section class="py-32 text-center">
    <h1 class="text-5xl font-bold text-neutral-100">404</h1>
    <p class="mt-4 text-neutral-400">这个页面不存在。</p>
    <div class="mt-8 flex justify-center">
      <a href="/" class="btn-white">返回首页</a>
    </div>
  </section>
</Layout>