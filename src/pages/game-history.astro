---
import PageNeighbours from '../components/PageNeighbours.astro';
import GameReviewTip from '../components/GameReviewTip.astro';
import Layout from '../layouts/Layout.astro';
import { gameCategories, totalGameCount, findGame } from '../data/games';
import '../styles/portfolio-rooms.css';
import '../styles/town-residents.css';
const selected = [
  { name: '博德之门3', topic: '一颗骰子，一整个故事。', icon: '/images/poker/poker-suit-choice.svg' },
  { name: '骑马与砍杀系列', topic: '战场之外，经济也在流动。', icon: '/images/poker/poker-suit-compass.svg' },
  { name: '暗黑地牢系列', topic: '压力，也是冒险的一部分。', icon: '/images/poker/poker-suit-double-face.svg' },
  { name: '杀戮尖塔系列', topic: '下一张牌，下一次选择。', icon: '/images/poker/poker-suit-connection.svg' },
].map(note => ({ ...note, game: findGame(note.name) })).filter(note => note.game?.comment);
---
<Layout title="游戏经历" description="明鑫的游戏经历、系统观察与游戏设计评述。">
  <div class="pf-container pf-room pf-club-room">
    <header class="pf-room-header"><div><p class="pf-room-kicker">玩家俱乐部 <span>/ {totalGameCount} 款游玩记录</span></p><h1>通关以后，<br />还会想起。</h1></div><div class="pf-club-console" aria-hidden="true"><span class="pf-club-console__screen"><img src="/images/characters/pocket-monster.svg" alt="" width="48" height="48" /></span><span class="pf-club-console__pad"></span><span class="pf-club-console__buttons"></span></div></header>
    <section class="pf-club-notes" aria-label="游戏评述摘选">{selected.map(({game, topic, icon}, i) => game && <details class="pf-club-note"><summary><span class="pf-club-note__number" aria-hidden="true">0{i + 1}</span><img src={icon} alt="" width="64" height="64" /><span class="pf-club-note__title"><small>{game.name}</small><strong>{topic}</strong></span><span class="pf-club-note__toggle" aria-hidden="true">+</span></summary><div class="pf-club-note__body">{game.hours && <p class="pf-club-note__hours">游玩记录 · {game.hours} 小时</p>}{game.comment?.split('\n\n').map(paragraph => <p>{paragraph}</p>)}{game.name === '博德之门3' && <a href="/docs/bg3/">阅读完整拆解 <span aria-hidden="true">↗</span></a>}</div></details>)}</section>
    <section class="pf-club-catalog" aria-labelledby="archive-title"><div class="pf-archive__heading"><h2 id="archive-title">游玩图鉴</h2><p>{totalGameCount} 款</p></div><div class="pf-club-drawers">{gameCategories.map((category, i) => <details><summary><span class="pf-club-drawers__number" aria-hidden="true">{String(i + 1).padStart(2,'0')}</span><strong>{category.title}</strong><span>{category.groups.reduce((sum, group) => sum + group.items.length, 0)} 款</span><b aria-hidden="true">+</b></summary><div>{category.groups.map(group => <section><h3>{group.subtitle || category.title}</h3><ul>{group.items.map(game => <li>{game.comment ? <button type="button" class="pf-game-review" data-game-name={game.name} data-game-review={game.comment} aria-expanded="false"><span>{game.name}</span>{game.hours && <small>{game.hours} h</small>}</button> : <><span>{game.name}</span>{game.hours && <small>{game.hours} h</small>}</>}</li>)}</ul></section>)}</div></details>)}</div></section>
    <GameReviewTip />
    <PageNeighbours section="games" />
  </div>
</Layout>