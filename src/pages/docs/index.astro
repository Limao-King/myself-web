---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import Reveal from '../../components/Reveal.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/format';
import { siteConfig } from '../../site.config';

const docs = (await getCollection('docs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const byCategory = (c: string) => docs.filter((d) => d.data.category === c);

const pinned = [
  { title: '拆解案', desc: '分析他人作品的设计逻辑', items: byCategory('拆解案') },
  { title: '策划案', desc: '我主导的完整设计案', items: byCategory('策划案') },
];

const writingGroups = [
  { subtitle: '剧本', items: byCategory('剧本') },
  { subtitle: '世界观', items: byCategory('世界观') },
];
---

<Layout title="策划文档" description="拆解案、策划案、剧本、对白与世界观文档" theme="eb2">
  <div class="py-12">
    {/* 首屏标题与筛选器直接渲染（Reveal 豁免）：慢设备上 IO 回调被字体解析
        拖慢时会先看到半透明鬼影。下方列表保留滚动入场。 */}
    <SectionHeading
      as="h1"
      title="策划文档"
      description={`共 ${docs.length} 篇。这里收录系统拆解、完整策划案，以及剧本、对白与世界观写作文档，随写作实时更新。`}
    />

    <!-- 轻量筛选：关键词 + 类型 -->
    <div class="mb-8">
      <input
        id="doc-search"
        type="search"
        placeholder="搜索文档标题 / 摘要 / 标签…"
        class="w-full max-w-sm rounded-lg border-2 border-[#262016] bg-white px-3 py-2 text-sm text-[#262016] outline-none focus:border-[#4c8a30]"
        aria-label="搜索文档"
      />
      <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="按类型筛选文档">
        <button type="button" data-filter-type="all" class="filter-chip is-active" aria-pressed="true">全部</button>
        {['拆解案', '策划案', '剧本', '世界观'].map((t) => (
          <button type="button" data-filter-type={t} class="filter-chip" aria-pressed="false">{t}</button>
        ))}
      </div>
      <p id="doc-results" class="mt-3 text-sm text-neutral-400" role="status" aria-live="polite">显示全部 {docs.length} 篇文档</p>
    </div>

    <!-- 置顶：拆解案 + 策划案 -->
    {
      pinned.map((group, gi) =>
        group.items.length > 0 ? (
          <Reveal delay={gi * 80}>
            <section class="mb-10">
              <h2 class="mb-1 flex items-center gap-3 text-xl font-bold text-neutral-100">
                <span class="inline-block h-4 w-1.5 bg-violet-500" aria-hidden="true"></span>
                {group.title}
              </h2>
              <p class="mb-4 pl-[1.125rem] text-sm text-neutral-400">{group.desc}</p>
              <div class="doc-grid grid gap-5 sm:grid-cols-2">
                {
                  group.items.map((d) => (
                    <div class="doc-item" data-type={d.data.category} data-text={`${d.data.title} ${d.data.summary} ${d.data.tags.join(' ')} ${d.data.kind ?? ''}`}>
                      <Card
                        href={`/docs/${d.id}/`}
                        title={d.data.title}
                        meta={formatDate(d.data.date)}
                        summary={d.data.summary}
                        tags={d.data.tags}
                      />
                    </div>
                  ))
                }
              </div>
            </section>
          </Reveal>
        ) : null
      )
    }

    <!-- 剧本文档 -->
    <Reveal delay={160}>
      <section>
        <h2 class="mb-1 flex items-center gap-3 text-xl font-bold text-neutral-100">
          <span class="inline-block h-4 w-1.5 bg-violet-500" aria-hidden="true"></span>
          剧本文档
        </h2>
        <p class="mb-5 pl-[1.125rem] text-sm text-neutral-400">剧本与世界观写作样本</p>

        <div class="space-y-8">
          {
            writingGroups.map((group) =>
              group.items.length > 0 ? (
                <div>
                  <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-neutral-400">
                    {group.subtitle}
                    <span class="font-normal normal-case text-neutral-400">（{group.items.length} 篇）</span>
                  </h3>
                  <div class="doc-grid grid gap-5 sm:grid-cols-2">
                    {
                      group.items.map((d) => (
                        <div class="doc-item" data-type={d.data.category} data-text={`${d.data.title} ${d.data.summary} ${d.data.tags.join(' ')} ${d.data.kind ?? ''}`}>
                          <Card
                            href={`/docs/${d.id}/`}
                            title={d.data.title}
                            meta={d.data.kind ? `${d.data.kind} · ${formatDate(d.data.date)}` : formatDate(d.data.date)}
                            summary={d.data.summary}
                            tags={d.data.tags}
                          />
                        </div>
                      ))
                    }
                  </div>
                </div>
              ) : null
            )
          }
        </div>
      </section>
    </Reveal>

    {
      docs.length === 0 && (
        <p class="text-sm text-neutral-500">
          还没有文档。新建一个 .md 放进 <code class="text-green-text">src/content/docs/</code> 即可显示。
        </p>
      )
    }

    <!-- 次要入口：全部文档 & Demo 打包下载（放最底部；主入口按钮化，括号说明弱化） -->
    <Reveal delay={80}>
      <div class="mt-14 flex flex-wrap items-center gap-3 border-t border-neutral-800 pt-6">
        <a
          href={siteConfig.downloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          全部文档 &amp; Demo 打包下载
        </a>
        <span class="text-xs text-neutral-500">备用网盘入口 · 提取码 {siteConfig.downloadPwd}</span>
      </div>
    </Reveal>
  </div>
</Layout>

<style>
  /* 奇数张的板块：最后一张跨两列，避免右列留空洞（拆解案 1 张同理变全宽） */
  @media (min-width: 640px) {
    .doc-grid > .doc-item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  function initDocFilters() {
    const input = document.getElementById('doc-search');
    const btns = [...document.querySelectorAll('[data-filter-type]')];
    const status = document.getElementById('doc-results');
    if (!input || input.dataset.bound) return;
    input.dataset.bound = '1';
    let curType = 'all';

    const apply = () => {
      const kw = (input.value || '').trim().toLowerCase();
      let count = 0;
      document.querySelectorAll('.doc-item').forEach((el) => {
        const visible = (curType === 'all' || el.dataset.type === curType) && (!kw || (el.dataset.text || '').toLowerCase().includes(kw));
        el.hidden = !visible;
        if (visible) count += 1;
      });
      if (status) status.textContent = count ? `找到 ${count} 篇文档` : '没有找到匹配的文档，请尝试其他关键词。';
    };

    input.addEventListener('input', apply);
    btns.forEach((button) => button.addEventListener('click', () => {
      curType = button.dataset.filterType || 'all';
      btns.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      apply();
    }));
    apply();
  }
  initDocFilters();
  document.addEventListener('astro:after-swap', initDocFilters);
</script>
