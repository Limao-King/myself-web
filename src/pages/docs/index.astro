---
import PageNeighbours from '../../components/PageNeighbours.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/format';
import '../../styles/portfolio-rooms.css';

const docs = (await getCollection('docs')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const chosen = [
  { id: 'fairytale-plan', name: '童话冒险', kind: '主策划案', emblem: 'manuscript' },
  { id: 'bg3', name: '博德之门 3', kind: '核心系统拆解', emblem: 'dice' },
  { id: 'death-stranding', name: '死亡搁浅', kind: '异步联机系统', emblem: 'connection' },
].map(item => ({ ...item, doc: docs.find(doc => doc.id === item.id) })).filter(item => item.doc);
const categories = ['全部', '策划案', '拆解案', '世界观', '剧本', '对白'];
---
<Layout title="策划文档" description="明鑫的系统策划案、游戏机制拆解、世界观与剧本文档。">
  <div class="pf-container pf-room pf-library-room">
    <header class="pf-room-header">
      <div><p class="pf-room-kicker">小镇资料馆 <span>/ {docs.length} 册</span></p><h1>纸上的冒险。</h1></div>
      <span class="pf-library-window" aria-hidden="true"><i></i></span>
    </header>
    <section class="pf-bookshelf" aria-label="精选文档">
      {chosen.map(({id, name, kind, emblem, doc}) => doc && <a href={`/docs/${id}/`} class={`pf-book pf-book--${emblem}`} aria-label={`阅读${doc.data.title}`}>
        <span class="pf-book__spine" aria-hidden="true"></span>
        <svg class="pf-book__emblem" viewBox="0 0 120 120" fill="none" aria-hidden="true">
          {emblem === 'manuscript' && <><path d="M32 23H77L91 38V97H32V23Z" stroke="currentColor" stroke-width="3" /><path d="M77 23V38H91M44 52H78M44 62H68M44 72H58" stroke="currentColor" stroke-width="3" /><path d="M64 91L66 80L91 55L100 64L75 89L64 91Z" fill="var(--book-paper)" stroke="currentColor" stroke-width="3" /></>}
          {emblem === 'dice' && <><path d="M60 15L104 42V86L60 109L16 86V42L60 15Z" stroke="currentColor" stroke-width="3" /><path d="M60 15L35 52L16 86M60 15L85 52L104 86M35 52H85L60 109L35 52ZM16 42L35 52M104 42L85 52" stroke="currentColor" stroke-width="2" /><circle cx="60" cy="66" r="5" fill="currentColor" /></>}
          {emblem === 'connection' && <><path d="M20 37H46V63H20V37ZM74 63H100V89H74V63Z" stroke="currentColor" stroke-width="3" /><path d="M46 50H68V76H74" stroke="currentColor" stroke-width="3" /><path d="M33 26V18M12 50H4M108 76H116M87 100V108" stroke="currentColor" stroke-width="3" /><circle cx="68" cy="50" r="5" fill="var(--book-paper)" stroke="currentColor" stroke-width="3" /></>}
        </svg>
        <div class="pf-book__title"><h2>{name}</h2><p>{kind}</p></div><span class="pf-book__open" aria-hidden="true">↗</span>
      </a>)}
    </section>
    <section class="pf-archive" aria-labelledby="catalog-title">
      <div class="pf-archive__heading"><h2 id="catalog-title">馆藏目录</h2><p id="doc-count" role="status" aria-live="polite">{docs.length} 册</p></div>
      <div class="pf-archive__tools"><label class="pf-archive__search" for="doc-search"><span>查找</span><input id="doc-search" type="search" placeholder="标题或关键词" autocomplete="off" /></label><div class="pf-archive__filters" role="group" aria-label="按文档类型筛选">{categories.map((category, i) => <button type="button" data-filter={category} aria-pressed={i === 0 ? 'true' : 'false'}>{category}</button>)}</div></div>
      <div class="pf-archive__list">{docs.map((doc, i) => <a href={`/docs/${doc.id}/`} class="pf-archive-entry" data-doc-card data-category={doc.data.category} data-search={`${doc.data.title} ${doc.data.summary} ${doc.data.tags.join(' ')}`}>
        <span class="pf-archive-entry__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="pf-archive-entry__category">{doc.data.category}</span><h3>{doc.data.title}</h3><time datetime={doc.data.date.toISOString()}>{formatDate(doc.data.date)}</time><span class="pf-archive-entry__arrow" aria-hidden="true">↗</span>
      </a>)}</div><p id="doc-empty" class="pf-empty" hidden>更多文档正在加紧准备中</p>
    </section>
    <PageNeighbours section="docs" />
  </div>
</Layout>
<script>
  const input = document.getElementById('doc-search');
  const buttons = [...document.querySelectorAll('[data-filter]')];
  const cards = [...document.querySelectorAll('[data-doc-card]')];
  const count = document.getElementById('doc-count');
  const empty = document.getElementById('doc-empty');
  let filter = '全部';
  const update = () => {
    const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
    let visible = 0;
    cards.forEach((card) => {
      const matches = (filter === '全部' || card.getAttribute('data-category') === filter) && (!query || (card.getAttribute('data-search') || '').toLowerCase().includes(query));
      if (card instanceof HTMLElement) card.hidden = !matches;
      if (matches) visible++;
    });
    if (count) count.textContent = `${visible} 册`;
    if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
  };
  input?.addEventListener('input', update);
  buttons.forEach((button) => button.addEventListener('click', () => {
    filter = button.getAttribute('data-filter') || '全部';
    buttons.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
    update();
  }));
</script>
