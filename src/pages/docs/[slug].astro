---
import Layout from '../../layouts/Layout.astro';
import Reveal from '../../components/Reveal.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/format';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((d) => ({ params: { slug: d.id }, props: { doc: d } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const { title, date, category, pdf, tags } = doc.data;
const isDialogue = category === '对白';
---

<Layout title={title} description={doc.data.summary}>
  <article class="py-12">
    <nav class="text-sm">
      <a href="/docs/" class="link-underline text-neutral-400 transition-colors hover:text-green-text">← 返回策划文档</a>
    </nav>

    <Reveal>
      <header class="mt-6">
        <h1 class="font-body text-3xl font-bold text-neutral-100">{title}</h1>
        <p class="mt-3 text-sm text-neutral-400">{formatDate(date)} · {category}</p>
        {
          tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {tags.map((t) => (
                <span class="rounded-full border border-neutral-800 bg-neutral-900 px-3 py-1 text-xs text-neutral-300">{t}</span>
              ))}
            </div>
          )
        }
        {
          pdf && (
            <div class="mt-6">
              <a
                href={pdf}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                下载 PDF 版
              </a>
            </div>
          )
        }
      </header>
    </Reveal>

    <Reveal delay={120}>
      <div class:list={['prose-article mt-10', isDialogue && 'dialogue-box']}>
        <Content />
      </div>
    </Reveal>
  </article>
</Layout>