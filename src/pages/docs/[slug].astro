---
import PageNeighbours from '../../components/PageNeighbours.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/format';
import '../../styles/reading-room.css';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const { title, date, category, pdf, summary } = doc.data;
---
<Layout title={title} description={summary}>
  <div class="pf-container pf-inner-page pf-doc-page">
    <nav class="pf-breadcrumb" aria-label="返回路径"><a href="/docs/">← 返回策划文档</a></nav>
    <header class="pf-doc-hero"><p class="pf-overline">{category} / {formatDate(date)}</p><h1>{title}</h1><p>{summary}</p>{pdf && <div class="pf-doc-hero__meta"><a href={pdf} target="_blank" rel="noopener noreferrer">带走 PDF ↗</a></div>}</header>
    <div class="pf-doc-layout"><article class="pf-prose"><Content /></article>{headings.length > 0 && <aside class="pf-doc-toc"><details><summary>本文目录</summary><nav aria-label="本文目录">{headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`} class:list={[heading.depth === 3 && 'is-sub']}>{heading.text}</a>)}</nav></details></aside>}</div>
    <PageNeighbours section="docs" />
  </div>
</Layout>
<script>
  // On wide screens the contents acts as a persistent reading aid; on phones it starts closed.
  if (window.matchMedia('(min-width: 1101px)').matches) {
    document.querySelector('.pf-doc-toc details')?.setAttribute('open', '');
  }

  // v4.18 阅读进度：把「视口上 35% 线以上最近的小节」在目录里点亮（读到哪里亮到哪里）；rAF 节流；无 JS 时只是没有高亮。
  const tocLinks = Array.from(document.querySelectorAll('.pf-doc-toc nav a'));
  if (tocLinks.length) {
    const linkById = new Map();
    tocLinks.forEach((a) => {
      const id = decodeURIComponent((a.getAttribute('href') || '').slice(1));
      if (id) linkById.set(id, a);
    });
    const headings = Array.from(document.querySelectorAll('.pf-prose [id]')).filter((h) => linkById.has(h.id));
    if (headings.length) {
      let raf = 0;
      const syncToc = () => {
        raf = 0;
        const line = window.innerHeight * 0.35;
        let current = null;
        for (const h of headings) {
          if (h.getBoundingClientRect().top <= line) current = h;
          else break;
        }
        tocLinks.forEach((a) => {
          const selected = !!current && a === linkById.get(current.id);
          a.classList.toggle('is-current', selected);
          if (selected) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        });
      };
      window.addEventListener('scroll', () => { if (!raf) raf = window.requestAnimationFrame(syncToc); }, { passive: true });
      syncToc();
    }
  }
</script>
