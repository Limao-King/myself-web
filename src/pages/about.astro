---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Reveal from '../components/Reveal.astro';
import { siteConfig } from '../site.config';

const education = [
  {
    school: '集美大学',
    major: '戏剧影视文学 · 本科',
    period: '2022.09 – 2027.06',
    note: '主修课程：戏剧剧本创作、影视剧本创作、电影理论、艺术概论、中外电影史。',
  },
];

const skillGroups = [
  {
    name: '引擎与工具',
    skills: ['Godot 基础开发', 'Excel / 配置表 / 数值曲线', '流程图工具（系统与关卡设计）'],
  },
  {
    name: '代码与编程',
    skills: ['基础代码阅读与调试', 'AI 辅助脚本编写'],
  },
  {
    name: '策划与叙事',
    skills: ['游戏剧本写作', '过场动画分镜', '系统设计文档撰写', '世界观构建与角色塑造'],
  },
];
---

<Layout title="关于我" description="我的个人简介、教育背景与技能栈" theme="eb2">
  <div class="py-12 about-page">
    <Reveal>
      <section class="about-hero">
        <div>
          <p class="about-kicker">ABOUT / PLAYER PROFILE</p>
          <h1>你好，我是明鑫。</h1>
          <p>一名把系统设计与叙事表达放在一起思考的游戏策划求职者。我希望不仅写出“看起来完整”的方案，也能通过原型、拆解和持续迭代验证设计。</p>
          <div class="about-actions">
            <a href={siteConfig.resumeUrl} target="_blank" rel="noopener" class="btn-primary">下载简历</a>
            <a href={`mailto:${siteConfig.email}`} class="btn-ghost">发送邮件</a>
          </div>
        </div>
      </section>
    </Reveal>

    <!-- 个人简介 -->
    <Reveal>
      <section class="mb-12">
        <div class="nes-container is-dark mb-5 max-w-2xl">
          <p class="text-sm">策划之外，我也长期保持阅读、观影和写作习惯。它们帮助我理解不同媒介如何组织信息、制造冲突，并塑造人物与世界。</p>
        </div>
        <div class="space-y-3 leading-relaxed text-neutral-300">
          <p>我待人真诚，也乐于沟通协作；遇到感兴趣的问题，会持续查资料、做记录，并尝试把理解转化成可执行的方案。</p>
          <p>游戏之外，我喜欢阅读文史哲作品和观看电影，熟悉常见文本写作规范，也理解电影镜头的基本语法与组接原理。最近计划体验《空之轨迹 the 2nd》和《寒蝉鸣泣之时》。</p>
        </div>
      </section>
    </Reveal>

    <!-- 教育背景 -->
    <Reveal>
      <section class="mb-12">
        <h2 class="mb-4 text-xl font-semibold text-neutral-100">教育背景</h2>
        <ul class="space-y-4">
          {
            education.map((e) => (
              <li class="rounded-xl border border-neutral-700 bg-neutral-900 p-5">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-semibold text-neutral-100">{e.school}</h3>
                  <p class="shrink-0 text-xs text-neutral-500">{e.period}</p>
                </div>
                <p class="mt-1 text-sm text-green-text">{e.major}</p>
                <p class="mt-2 text-sm text-neutral-400">{e.note}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </Reveal>

    <!-- 技能栈 -->
    <Reveal delay={80}>
      <section class="mb-12">
        <h2 class="mb-4 text-xl font-semibold text-neutral-100">技能栈</h2>
        <div class="space-y-5">
          {
            skillGroups.map((g) => (
              <div>
                <h3 class="mb-2 text-sm font-medium text-neutral-400">{g.name}</h3>
                <div class="flex flex-wrap gap-2">
                  {g.skills.map((s) => (
                    <span class="rounded-full border border-neutral-800 bg-neutral-900 px-3 py-1 text-sm text-neutral-300">{s}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </Reveal>

    <!-- 联系方式 -->
    <Reveal delay={160}>
      <section>
        <h2 class="mb-4 text-xl font-semibold text-neutral-100">联系方式</h2>
        <ul class="space-y-3 text-sm text-neutral-300">
          <li>邮箱：<a href={`mailto:${siteConfig.email}`} class="link-underline text-green-text">{siteConfig.email}</a></li>
          <li>GitHub：<a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="link-underline text-green-text">{siteConfig.github}</a></li>
          <li>简历（含联系方式）：<a href={siteConfig.resumeUrl} target="_blank" class="link-underline text-green-text">下载 PDF</a></li>
          <li>
            全部文档 / Demo 下载：
            <a href={siteConfig.downloadUrl} target="_blank" rel="noopener noreferrer" class="link-underline text-green-text">
              百度网盘（提取码 {siteConfig.downloadPwd}）
            </a>
          </li>
        </ul>
      </section>
    </Reveal>
  </div>
</Layout>

<style>
  .about-page { max-width:58rem; margin-inline:auto; }
  .about-hero { margin-bottom:3.5rem; padding:clamp(1.75rem,4vw,3rem); background:#fffffa; border:2px solid #c8bda2; border-radius:14px; box-shadow:8px 8px 0 rgba(64,80,84,.12); }
  .about-kicker { color:#537984; font-family:"FusionPixel",var(--font-sans); font-size:.68rem; letter-spacing:.12em; }
  .about-hero h1 { margin-top:.6rem; color:#222c2f; font-size:clamp(2.2rem,5vw,3.7rem); font-weight:800; }
  .about-hero > div > p:last-of-type { max-width:42rem; margin-top:1rem; color:#536064; line-height:1.9; }
  .about-actions { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:1.5rem; }
  @media (max-width:720px) { .about-page { padding-top:1.25rem; } }
</style>
