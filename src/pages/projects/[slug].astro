---
import PageNeighbours from '../../components/PageNeighbours.astro';
import Layout from '../../layouts/Layout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import { getCollection, render } from 'astro:content';
import { caseNotes } from '../../data/case-notes';
import { formatPeriod } from '../../utils/format';
import '../../styles/reading-room.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const note = caseNotes[project.id];
const { title, cover, type, role, playUrl, planDoc, planLabel, videoUrl, demoUrl, demoLabel, screenshots } = project.data;
const leadImage = project.id === 'fairytale-demo' ? '/images/projects/fairytale/02-move-tutorial.jpg' : cover;
const displayTitle = { 'fairytale-demo': '童话冒险', gujie: '上元古界', 'chaos-three-kingdoms': '乱世三国', huanzhenming: '唤她真名' }[project.id] ?? title;
---
<Layout title={title} description={project.data.summary} ogImage={cover}>
  <div class="pf-container pf-inner-page pf-case-page">
    <nav class="pf-breadcrumb" aria-label="返回路径"><a href="/projects/">← 返回项目案例</a></nav>
    <header class="pf-case-hero"><div class="pf-case-hero__copy"><p class="pf-overline">{note?.eyebrow ?? type} / {formatPeriod(project.data.start, project.data.date)}</p><h1>{displayTitle}</h1><p class="pf-case-hero__summary">{project.data.summary}</p><div class="pf-case-hero__tags"><span>{note?.status ?? type}</span><span>我的职责：{role}</span></div><div class="pf-case-hero__links">{playUrl && <a class="pf-button pf-button--primary" href={playUrl} target="_blank" rel="noopener noreferrer">开始试玩 ↗</a>}{videoUrl && <a class="pf-button pf-button--outline" href={videoUrl} target="_blank" rel="noopener noreferrer">观看演示视频 ↗</a>}{planDoc && <a class="pf-button pf-button--outline" href={planDoc}>{planLabel ?? '查看策划案'} ↗</a>}</div></div>{leadImage && <figure class="pf-case-hero__visual"><img src={leadImage} alt={`${title}项目画面`} /></figure>}</header>

    <section id="design-decisions" class="pf-case-analysis" aria-labelledby="decisions-title"><div class="pf-section__head"><h2 id="decisions-title">设计笔记</h2></div><div class="pf-decision-grid"><article><span aria-hidden="true">01</span><h3>题目</h3><p>{note?.challenge ?? project.data.summary}</p></article><article><span aria-hidden="true">02</span><h3>选择</h3><p>{note?.decision ?? project.data.summary}</p></article><article><span aria-hidden="true">03</span><h3>落地</h3><p>{note?.outcome ?? project.data.summary}</p></article></div></section>

    <section class="pf-case-evidence" aria-labelledby="evidence-title"><div><h2 id="evidence-title">随案材料</h2><p>{note?.proof ?? '项目记录、截图与关联文档'}</p></div><div class="pf-evidence-links">{planDoc && <a href={planDoc}>相关手稿 ↗</a>}{demoUrl && <a href={demoUrl} target="_blank" rel="noopener noreferrer">{demoLabel ?? '下载 Demo'} ↗</a>}</div></section>

    {screenshots?.length > 0 && <section class="pf-gallery-section" aria-labelledby="gallery-title"><div class="pf-section__head"><h2 id="gallery-title">项目现场</h2></div><ImageGallery images={screenshots} /></section>}

    <details class="pf-longform"><summary><strong>项目经过与复盘</strong><span class="pf-longform__action"><small><span class="pf-longform__closed">展开阅读</span><span class="pf-longform__open">收起内容</span></small><b aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M3 6L8 11L13 6" stroke="currentColor" stroke-width="2" /></svg></b></span></summary><div class="pf-prose"><Content /></div></details>

    <PageNeighbours section="projects" />
  </div>
</Layout>
