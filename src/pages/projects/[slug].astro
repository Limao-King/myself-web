---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/format';
import ImageGallery from '../../components/ImageGallery.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, date, type, platform, role, teamSize, duration, demoUrl, demoLabel, videoUrl, planDoc, planLabel, tags, screenshots } = project.data;
---

<Layout title={title} description={project.data.summary} ogImage={project.data.cover} theme="eb" panel={false}>
  <div class="flex flex-col gap-6">
    <!-- 任务卡头部 -->
    <section class="eb-battle">
      <a href="/projects/" class="eb-backlink text-sm">← 返回任务日志</a>
      <h1 class="eb-battle__title">任务：{title}</h1>
      <p class="project-summary">{project.data.summary}</p>
      <p class="eb-ev mt-2">完成时间 · {formatDate(date)}</p>

      <!-- 项目情况（从「周期/团队等标签」挪进正文的结构化信息） -->
      <div class="mt-4 rounded-lg border-2 border-[var(--eb-frame)]/40 bg-[#f6f6dd] p-4">
        <p class="mb-2 font-pixel text-sm text-[var(--eb-yellow)]">◆ 项目情况</p>
        <dl class="project-meta grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
          <div><dt>类型</dt><dd>{type}</dd></div>
          <div><dt>平台</dt><dd>{platform}</dd></div>
          <div><dt>团队</dt><dd>{teamSize}</dd></div>
          <div><dt>周期</dt><dd>{duration}</dd></div>
          <div class="project-meta__role"><dt>我的角色</dt><dd>{role}</dd></div>
        </dl>
      </div>

      <!-- 核心标签（精简，剔除已进项目情况的冗余项与类型/平台等） -->
      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="rounded px-2 py-1 text-xs" style="background:#1f140d;color:var(--eb-frame)">{t}</span>
            ))}
          </div>
        )
      }

      <!-- 相关产出：直达按钮（策划案为主，视频次之，下载 Demo 最次） -->
      {
        (planDoc || videoUrl || demoUrl) && (
          <div class="mt-5 flex flex-wrap gap-3">
            {planDoc && <a href={planDoc} class="eb-btn-solid">{planLabel ?? '查看策划案'}</a>}
            {videoUrl && <a href={videoUrl} target="_blank" rel="noopener noreferrer" class="eb-btn-line">▶ 观看演示</a>}
            {demoUrl && <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="eb-btn-line">{demoLabel ?? '下载 Demo'}</a>}
          </div>
        )
      }
    </section>

    <!-- 截图图廊（可切换 + 描述） -->
    {
      screenshots?.length > 0 && (
        <ImageGallery images={screenshots} />
      )
    }

    <!-- 正文：图鉴纸质卡（保证长文可读） -->
    <div class="prose-article">
      <Content />
    </div>
  </div>
</Layout>

<style>
  .project-summary { max-width:46rem; margin-top:.75rem; padding-right:8rem; color:#423625; font-size:.94rem; line-height:1.75; }
  .project-meta > div { display:grid; grid-template-columns:4.5rem minmax(0,1fr); gap:.5rem; align-items:start; }
  .project-meta dt { color:#705f47; }
  .project-meta dd { min-width:0; color:#17120c; font-weight:700; overflow-wrap:anywhere; }
  .project-meta__role { grid-column:1 / -1; }
  @media (max-width:560px) {
    .project-meta { grid-template-columns:1fr; gap:.7rem; }
    .project-meta__role { grid-column:auto; }
    .eb-battle:has(> .eb-backlink) .eb-battle__title,
    .eb-battle:has(> .eb-backlink) > p.eb-ev,
    .eb-battle:has(> .eb-backlink) > .flex.flex-wrap { padding-right:0; }
    .eb-battle > .eb-backlink { position:static; margin-bottom:1.2rem; }
    .project-summary { padding-right:0; }
  }
</style>
