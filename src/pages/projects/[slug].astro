---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/format';
import ImageGallery from '../../components/ImageGallery.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, date, type, platform, role, teamSize, duration, demoUrl, demoLabel, videoUrl, planDoc, planLabel, tags, screenshots } = project.data;
---

<Layout title={title} description={project.data.summary} theme="eb" panel={false}>
  <div class="flex flex-col gap-6">
    <!-- 任务卡头部 -->
    <section class="eb-battle">
      <a href="/projects/" class="eb-backlink text-sm">← 返回任务日志</a>
      <h1 class="eb-battle__title">任务：{title}</h1>
      <p class="eb-ev mt-1">{formatDate(date)}</p>

      <!-- 项目情况（从「周期/团队等标签」挪进正文的结构化信息，占位，待补充深化） -->
      <div class="mt-4 rounded-lg border-2 border-[var(--eb-frame)]/40 p-4">
        <p class="mb-2 font-pixel text-sm text-[var(--eb-yellow)]">◆ 项目情况</p>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
          <div class="flex gap-2"><dt class="text-[#a89c78]">类型</dt><dd class="text-[#f8eed2]">{type}</dd></div>
          <div class="flex gap-2"><dt class="text-[#a89c78]">平台</dt><dd class="text-[#f8eed2]">{platform}</dd></div>
          <div class="flex gap-2"><dt class="text-[#a89c78]">团队</dt><dd class="text-[#f8eed2]">{teamSize}</dd></div>
          <div class="flex gap-2"><dt class="text-[#a89c78]">周期</dt><dd class="text-[#f8eed2]">{duration}</dd></div>
          <div class="col-span-2 flex gap-2"><dt class="text-[#a89c78]">我的角色</dt><dd class="text-[#f8eed2]">{role}</dd></div>
        </dl>
      </div>

      <!-- 核心标签（精简，剔除已进项目情况的冗余项与类型/平台等） -->
      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="rounded px-2 py-1 text-xs" style="background:#1f140d;color:var(--eb-frame)">{t}</span>
            ))}
          </div>
        )
      }

      <!-- 相关产出：直达按钮（策划案为主，视频次之，下载 Demo 最次） -->
      {
        (planDoc || videoUrl || demoUrl) && (
          <div class="mt-5 flex flex-wrap gap-3">
            {planDoc && <a href={planDoc} class="eb-btn-solid">{planLabel ?? '查看策划案'}</a>}
            {videoUrl && <a href={videoUrl} target="_blank" rel="noopener noreferrer" class="eb-btn-line">▶ 观看演示</a>}
            {demoUrl && <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="eb-btn-line">{demoLabel ?? '下载 Demo'}</a>}
          </div>
        )
      }
    </section>

    <!-- 截图图廊（可切换 + 描述） -->
    {
      screenshots?.length > 0 && (
        <ImageGallery images={screenshots} />
      )
    }

    <!-- 正文：图鉴纸质卡（保证长文可读） -->
    <div class="prose-article">
      <Content />
    </div>
  </div>
</Layout>
