---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 按开始时间从新到旧排（缺省退回 date），保证叠纸与日志顺序一致
const projects = (await getCollection('projects')).sort(
  (a, b) => (b.data.start ?? b.data.date).valueOf() - (a.data.start ?? a.data.date).valueOf()
);

// 叠纸区重点：古界 / 唤她 作为更拿得出手的代表作，放大并居中；其余常规小纸
const inSpotlight = (p: { data: { featured?: boolean } }) => Boolean(p.data.featured);
const tagsOf = (p: { data: { tags: string[] } }) => p.data.tags ?? [];
const coverOf = (p: { data: { cover?: string } }) => p.data.cover;
const roleOf = (p: { data: { role: string } }) => p.data.role;
---

<Layout title="项目" description="我的游戏项目" theme="eb" panel={false}>
  <div class="flex flex-col gap-6">
    <!-- 项目入口：按招聘方扫描习惯直接展示职责、类型和项目证据 -->
    <section class="project-board">
      <header class="project-board__head">
        <div>
          <p class="project-board__eyebrow">SELECTED QUESTS · {projects.length} PROJECTS</p>
          <h1>项目与实践</h1>
          <p>从可玩原型到世界观与剧本项目。每个项目中我的具体职责、过程与产出都已注明。</p>
        </div>
        <span class="project-board__stamp" aria-hidden="true">WORK<br />LOG</span>
      </header>
      <div class="project-showcase">
        {projects.map((p, i) => (
          <a href={`/projects/${p.id}/`} class:list={['project-feature', inSpotlight(p) && 'is-spotlight']}>
            <div class="project-feature__visual">
              {coverOf(p) ? <img src={coverOf(p)} alt="" loading={i === 0 ? 'eager' : 'lazy'} /> : <span aria-hidden="true">QUEST {String(i + 1).padStart(2, '0')}</span>}
            </div>
            <div class="project-feature__body">
              <p class="project-feature__meta">{new Date(p.data.date).getFullYear()} · {p.data.type}</p>
              <h2>{p.data.title}</h2>
              <p class="project-feature__role">我的职责 · {roleOf(p)}</p>
              <p class="project-feature__summary">{p.data.summary}</p>
              <div class="project-feature__tags">{tagsOf(p).slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
              <span class="project-feature__cta">查看项目过程与产出 <b aria-hidden="true">→</b></span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>

<style>
  .project-board { position:relative; padding:clamp(1.5rem,4vw,2.75rem); background:#efe7ce; border:3px solid #262016; border-radius:12px; box-shadow:0 0 0 3px var(--eb-frame),10px 10px 0 rgba(0,0,0,.22); overflow:hidden; }
  .project-board::before { content:""; position:absolute; inset:0; background:linear-gradient(rgba(120,80,40,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(120,80,40,.055) 1px,transparent 1px); background-size:24px 24px; pointer-events:none; }
  .project-board__head { position:relative; display:flex; justify-content:space-between; gap:2rem; align-items:flex-start; margin-bottom:2rem; }
  .project-board__eyebrow { color:#6c573d; font-family:"FusionPixel",var(--font-sans); font-size:.68rem; letter-spacing:.12em; }
  .project-board__head h1 { margin-top:.45rem; color:#201a12; font-size:clamp(2rem,5vw,3.4rem); font-weight:800; letter-spacing:-.025em; }
  .project-board__head p:last-child { max-width:42rem; margin-top:.75rem; color:#5d503f; font-size:.92rem; line-height:1.8; }
  .project-board__stamp { flex:none; display:grid; place-items:center; width:5.2rem; height:5.2rem; border:3px double #7e351d; border-radius:50%; color:#7e351d; font-family:"FusionPixel",var(--font-sans); font-size:.75rem; line-height:1.45; text-align:center; transform:rotate(8deg); opacity:.9; }
  .project-showcase { position:relative; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .project-feature { display:grid; grid-template-columns:9rem minmax(0,1fr); height:20rem; background:#fdf8e8; border:2px solid #33291d; border-radius:7px; overflow:hidden; box-shadow:5px 5px 0 rgba(38,32,22,.15); transition:transform .2s ease,box-shadow .2s ease; }
  .project-feature:hover,.project-feature:focus-visible { transform:translateY(-4px); box-shadow:7px 9px 0 rgba(38,32,22,.18); }
  .project-feature__visual { min-height:100%; display:grid; place-items:center; overflow:hidden; background:#394d2d; color:#f8f4dc; font-family:"FusionPixel",var(--font-sans); letter-spacing:.12em; }
  /* 竖排只给无图占位文字；writing-mode 不能挂在容器上，否则 img 的 width:100% 会失效（封面被裁成中间一条） */
  .project-feature__visual > span { writing-mode:vertical-rl; }
  .project-feature__visual img { width:100%; height:100%; object-fit:cover; transition:transform .35s ease; }
  .project-feature:hover .project-feature__visual img { transform:scale(1.035); }
  .project-feature__body { display:flex; flex-direction:column; min-width:0; padding:1.2rem; }
  .project-feature__meta { color:#746149; font-size:.68rem; font-weight:700; letter-spacing:.06em; }
  .project-feature h2 { margin-top:.45rem; color:#231c14; font-family:var(--font-sans); font-size:1.2rem; font-weight:800; line-height:1.35; text-wrap:balance; }
  .project-feature__role { margin-top:.55rem; color:#8f472e; font-size:.76rem; font-weight:700; }
  .project-feature__summary { margin-top:.7rem; color:#554939; font-size:.82rem; line-height:1.7; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  .project-feature__tags { display:flex; flex-wrap:wrap; gap:.35rem; margin-top:.8rem; }
  .project-feature__tags span { padding:.18rem .45rem; background:#dfe8c3; color:#3d542c; border-radius:3px; font-size:.64rem; font-weight:700; }
  .project-feature__cta { margin-top:auto; padding-top:1rem; color:#743d24; font-size:.76rem; font-weight:700; }
  @media (max-width:880px) { .project-showcase { grid-template-columns:1fr; } }
  @media (max-width:560px) {
    .project-board { padding:1.25rem; }
    .project-board__stamp { display:none; }
    .project-feature { grid-template-columns:1fr; height:auto; min-height:0; }
    .project-feature__visual { min-height:10rem; max-height:12rem; }
    .project-feature__visual > span { writing-mode:horizontal-tb; }
    .project-feature__body { padding:1.1rem; }
  }

  /* 旧叠纸方案样式保留，便于按需回退。 */
  .paper-zone {
    position: relative;
    overflow: hidden;
    background:
      repeating-linear-gradient(90deg, rgba(120, 80, 40, 0.06) 0 1px, transparent 1px 24px),
      repeating-linear-gradient(0deg, rgba(120, 80, 40, 0.06) 0 1px, transparent 1px 24px),
      linear-gradient(#e8e0c8, #e8e0c8);
    border: 4px solid #262016;
    border-radius: 12px;
    box-shadow: 0 0 0 3px var(--eb-frame), 10px 10px 0 rgba(0, 0, 0, 0.24);
    padding: 30px 28px 34px;
  }
  .paper-zone__title {
    text-align: center;
    color: #262016;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    letter-spacing: 0.04em;
    margin-bottom: 26px;
    text-shadow: none;
  }
  .paper-zone__hint {
    text-align: center;
    font-size: 0.72rem;
    color: #6b5a3e;
    margin-top: 14px;
    letter-spacing: 0.08em;
  }
  .paper-zone__stack {
    position: relative;
    max-width: 880px;
    height: 470px;
    margin: 0 auto;
  }
  /* 记录纸：横线纸 + 顶部折角，交叠露出一点 */
  .note {
    position: absolute;
    width: min(440px, 72%);
    padding: 26px 28px 22px;
    border: 3px solid #262016;
    border-radius: 3px;
    background:
      linear-gradient(transparent 0 28px, rgba(0, 0, 0, 0.05) 28px 29px),
      repeating-linear-gradient(0deg, rgba(203, 184, 144, 0.6) 0 1px, transparent 1px 28px),
      #f6efdb;
    box-shadow: 0 0 0 2px var(--eb-frame), 12px 12px 0 rgba(0, 0, 0, 0.32);
    transform: rotate(var(--r, 0deg));
    transition: transform 0.5s cubic-bezier(0.2, 1, 0.3, 1), box-shadow 0.5s, z-index 0s;
    z-index: calc(var(--z, 1));
    cursor: pointer;
  }
  .note:after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    width: 24px;
    height: 24px;
    background: linear-gradient(135deg, #f6efdb 50%, rgba(0, 0, 0, 0.13) 50%);
    border-left: 2px solid rgba(0, 0, 0, 0.12);
  }
  .note:hover {
    transform: rotate(0deg) translateY(-12px) scale(1.05);
    box-shadow: 0 0 0 2px var(--eb-frame), 28px 28px 0 rgba(0, 0, 0, 0.26);
    z-index: 99;
  }
  .note em {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: #785028;
  }
  .note h3 {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.05;
    margin: 0.5rem 0;
  }
  .note .meta {
    font-size: 0.68rem;
    color: #6b5a3e;
    margin-bottom: 0.7rem;
  }
  .note p {
    font-size: 0.84rem;
    line-height: 1.65;
    opacity: 0.94;
  }
  .note .cta {
    display: block;
    margin-top: 1rem;
    font-size: 0.7rem;
    color: #e88858;
  }
  /* 交叠：每张露出约 25%，压住前一张大半 */
  .n1 { --r: -4deg; top: 8px; left: 4%; --z: 1; }
  .n2 { --r: 3deg; top: 52px; left: 27%; --z: 2; }
  .n3 { --r: -2deg; top: 100px; left: 50%; --z: 3; }
  .n4 { --r: 4deg; top: 150px; left: 36%; --z: 4; }
  /* 重点卡片：古界/唤她 抬升压在表面，更醒目 */
  .note--spot {
    z-index: 60;
    border-color: #785028;
    box-shadow: 0 0 0 2px var(--eb-frame), 16px 16px 0 rgba(0, 0, 0, 0.3);
  }
  @media (max-width: 720px) {
    .paper-zone__stack { height: 640px; }
    .note { width: 82%; }
    .n2 { left: 12%; }
    .n3 { left: 14%; }
    .n4 { left: 18%; }
  }
</style>
