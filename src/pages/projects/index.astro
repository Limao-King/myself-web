---
import PageNeighbours from '../../components/PageNeighbours.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { caseNotes } from '../../data/case-notes';
import { formatPeriod } from '../../utils/format';
import '../../styles/portfolio-rooms.css';

const projects = await getCollection('projects');
const exhibits = [
  { id: 'fairytale-demo', name: '童话冒险', kind: '可玩原型', line: '距离，也是回合里的选择。', image: '/images/projects/fairytale/04-distance.jpg', alt: '童话冒险的距离机制战斗画面' },
  { id: 'gujie', name: '上元古界', kind: '世界与任务', line: '让文明、年代与人，在同一片土地相遇。', image: '/images/projects/gujie/overview.jpg', alt: '上元古界的黎稷城场景' },
  { id: 'chaos-three-kingdoms', name: '乱世三国', kind: 'Minecraft RPG 地图', line: '一枚水晶，串起一座战场。', image: '/images/projects/sanguo/battle.jpg', alt: '乱世三国的山寨攻防战与水晶胜负系统' },
  { id: 'huanzhenming', name: '唤她真名', kind: '动画剧本', line: '民俗童话里，一场关于名字的悬疑。', image: '/images/projects/huanzhenming/mba.jpg', alt: '唤她真名的幻想之城概念美术' },
].map(exhibit => ({ ...exhibit, project: projects.find(p => p.id === exhibit.id) })).filter(exhibit => exhibit.project);
---
<Layout title="项目案例" description="明鑫的游戏策划项目：可玩 JRPG 原型、团队世界观、关卡与叙事实践。">
  <div class="pf-container pf-room pf-gallery-room">
    <header class="pf-room-header">
      <div><p class="pf-room-kicker">小镇展厅 <span aria-hidden="true">/ 01—04</span></p><h1>冒险的形状。</h1></div>
      <span class="pf-gallery-mark" aria-hidden="true"><img src="/images/scenes/gallery-mark.svg" alt="" width="72" height="72" /></span>
    </header>
    <div class="pf-exhibits">
      {exhibits.map((work, i) => work.project && <a class={`pf-exhibit pf-exhibit--${work.id}`} href={`/projects/${work.id}/`} aria-label={`查看${work.name}项目案例`}>
        <div class="pf-exhibit__frame"><span class="pf-exhibit__pin" aria-hidden="true"></span><img src={work.image} alt={work.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /><span class="pf-exhibit__status">{caseNotes[work.id]?.status ?? work.project.data.type}</span><span class="pf-exhibit__enter" aria-hidden="true">↗</span></div>
        <div class="pf-exhibit__caption"><span class="pf-exhibit__number" aria-hidden="true">0{i + 1}</span><div><p class="pf-exhibit__kind">{work.kind}</p><h2>{work.name}</h2><p class="pf-exhibit__line">{work.line}</p></div><time>{formatPeriod(work.project.data.start, work.project.data.date)}</time></div>
      </a>)}
    </div>
    <PageNeighbours section="projects" />
  </div>
</Layout>