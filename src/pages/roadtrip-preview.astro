  </main>

  <script>
    // ---------- 路线 token 沿 SVG 移动 ----------
    const path = document.getElementById('route-ink');
    const token = document.getElementById('token');
    const stopName = document.getElementById('stop-name');
    const stops = Array.from(document.querySelectorAll('[data-stop]'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let len = path.getTotalLength();
    let cur = 0, target = 0;

    function place(progress) {
      const p = path.getPointAtLength(progress * len);
      token.style.top = p.y + 'px';
      token.style.left = '50%';
    }
    function update() {
      const max = document.documentElement.scrollHeight - innerHeight;
      target = max > 0 ? Math.min(1, scrollY / max) : 0;
      cur += (target - cur) * 0.08;
      if (Math.abs(target - cur) < 0.0004) cur = target;
      place(cur);

      // 当前地标名
      const probe = document.elementFromPoint(innerWidth / 2, innerHeight * 0.5);
      let activeStop = null;
      const midY = scrollY + innerHeight * 0.45;
      for (const s of stops) {
        const r = s.getBoundingClientRect();
        const top = r.top + scrollY;
        if (top <= midY) activeStop = s;
      }
      if (activeStop) {
        stopName.textContent = activeStop.dataset.stop;
        stopName.classList.add('is-on');
      } else stopName.classList.remove('is-on');
      requestAnimationFrame(update);
    }
    addEventListener('scroll', () => { if (!reduce) target = scrollY / (document.documentElement.scrollHeight - innerHeight); }, { passive: true });
    if (!reduce) requestAnimationFrame(update);
    else place(1);

    // ---------- 能力对象：进入视口触发计数 + 条形 ----------
    const objs = Array.from(document.querySelectorAll('.obj'));
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting || e.target.dataset.fired) return;
        e.target.dataset.fired = '1';
        const targetN = +e.target.dataset.count || 0;
        const num = e.target.querySelector('.obj__num');
        const bar = e.target.querySelector('.obj__bar i');
        setTimeout(() => { if (bar) bar.style.width = (bar.dataset.w || 0) + '%'; }, 120);
        const t0 = performance.now();
        const dur = 900;
        const tick = (t) => {
          const k = Math.min(1, (t - t0) / dur);
          if (num) num.textContent = String(Math.round(targetN * (1 - Math.pow(1 - k, 3)))).padStart(2, '0');
          if (k < 1) requestAnimationFrame(tick);
          else if (num) num.textContent = String(targetN);
        };
        requestAnimationFrame(tick);
        setTimeout(() => e.target.classList.add('ev-on'), 1000);
        setTimeout(() => e.target.classList.remove('ev-on'), 4200);
      });
    }, { threshold: .45 });
    objs.forEach((o) => io.observe(o));

    // ---------- 鼠标在能力对象内轻微倾斜 ----------
    objs.forEach((o) => {
      o.addEventListener('mousemove', (e) => {
        const r = o.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - .5;
        const dy = (e.clientY - r.top) / r.height - .5;
        o.style.transform = `perspective(600px) rotateY(${dx * 5}deg) rotateX(${-dy * 5}deg)`;
      });
      o.addEventListener('mouseleave', () => { o.style.transform = ''; });
    });

    // ---------- 第三幕：精神异常扭曲 Canvas（低饱和暗场） ----------
    const warp = document.getElementById('warp');
    const ctx = warp.getContext('2d');
    const img = new Image();
    img.onload = () => {
      const src = document.createElement('canvas');
      src.width = img.width; src.height = img.height;
      const sctx = src.getContext('2d');
      sctx.drawImage(img, 0, 0);
      const buf = document.createElement('canvas');
      const bctx = buf.getContext('2d');
      const pat = bctx.createPattern(src, 'repeat');
      const resize = () => {
        const box = warp.getBoundingClientRect();
        const dpr = Math.min(2, devicePixelRatio || 1);
        warp.width = Math.max(1, Math.round(box.width * dpr));
        warp.height = Math.max(1, Math.round(box.height * dpr));
      };
      resize();
      addEventListener('resize', resize);
      const th = src.height;
      const render = (t) => {
        const W = warp.width, H = warp.height;
        const bufW = Math.max(th, W + 64);
        if (buf.width !== bufW) { buf.width = bufW; buf.height = th; bctx.fillStyle = pat; bctx.fillRect(0, 0, bufW, th); }
        ctx.clearRect(0, 0, W, H);
        ctx.imageSmoothingEnabled = false;
        for (let y = 0; y < H; y++) {
          const off = 16 * Math.sin(.05 * y + .004 * t) + 6 * Math.sin(.09 * y + .002 * t + 2);
          const shift = ((Math.round(off) % bufW) + bufW) % bufW;
          const sw = Math.min(W, bufW - shift);
          ctx.drawImage(buf, shift, y % th, sw, 1, 0, y, sw, 1);
          if (sw < W) ctx.drawImage(buf, 0, y % th, W - sw, 1, sw, y, W - sw, 1);
        }
        if (!reduce) requestAnimationFrame(render);
      };
      if (reduce) render(0); else requestAnimationFrame(render);
    };
    img.src = '/images/patterns/crystal.png';
  </script>
</body>
</html>
