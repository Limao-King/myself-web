---
// 预览页：方向一「白昼异变公路片」首页概念
// 自包含 demo（不套 Layout，独立场景），用于确认视觉方向后迁移回 index.astro。
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>白昼异变公路片 · 概念预览</title>
  <style>
    /* ============ 设计令牌：白昼异变公路片 ============ */
    :root {
      --ink: #17130f;      /* 暖黑墨 */
      --paper: #f6f1d1;    /* 晒太阳纸 */
      --sky: #63d9f5;      /* 异常天空蓝 */
      --road: #f2d34f;     /* 公路芥末黄 */
      --grass: #42a35a;    /* 潮湿草绿 */
      --alert: #f0523d;    /* 番茄警报红 */
      --grape: #7a5ac8;    /* 怪味葡萄紫 */
      --peach: #f49a8a;    /* 桃肉粉 */
      --mist: #b7ded2;     /* 雾青 */
      --wood: #765137;     /* 旧木褐 */
      --line: 3px;
      --pixel: "FusionPixel", "MiSans", ui-monospace, monospace;
    }
    * { box-sizing: border-box; margin: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: "MiSans", "PingFang SC", "Microsoft YaHei", sans-serif;
      color: var(--ink);
      line-height: 1.75;
      background: var(--paper);
    }
    .px { font-family: var(--pixel); }
    img { image-rendering: pixelated; }
    a { color: inherit; }
    ::selection { background: var(--road); }

    /* ============ 贯穿全页的冒险路线（左缘 fixed） ============ */
    .world-route {
      position: fixed;
      left: 14px;
      top: 0;
      height: 100vh;
      width: 46px;
      z-index: 60;
      pointer-events: none;
      display: flex;
      align-items: center;
    }
    .world-route svg { height: 96vh; width: 46px; overflow: visible; }
    .route-base { fill: none; stroke: rgba(23,19,15,.18); stroke-width: 3; stroke-dasharray: 4 6; }
    .route-ink { fill: none; stroke: var(--ink); stroke-width: 3; }
    .route-done { fill: none; stroke: var(--alert); stroke-width: 4; filter: drop-shadow(0 0 4px rgba(240,82,61,.6)); }
    .token {
      position: absolute;
      left: 50%;
      top: 0;
      width: 30px; height: 30px;
      transform: translate(-50%, -50%);
      font-family: var(--pixel);
      font-size: 17px;
      background: var(--paper);
      border: 3px solid var(--ink);
      box-shadow: 3px 3px 0 rgba(23,19,15,.4);
      display: flex; align-items: center; justify-content: center;
      z-index: 61;
    }
    .stop-name {
      position: absolute;
      left: 56px;
      transform: translateY(-50%);
      font-family: var(--pixel);
      font-size: 10px;
      letter-spacing: .04em;
      color: var(--ink);
      background: var(--paper);
      border: 2px solid var(--ink);
      padding: 2px 8px;
      white-space: nowrap;
      opacity: 0;
      transition: opacity .3s;
    }
    .stop-name.is-on { opacity: 1; border-color: var(--alert); }

    /* ============ 幕：每幕占视口 90%+，场景色主导 ============ */
    main { padding: 0 0 40px; }
    .act {
      min-height: 92vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 40px 24px 40px 84px;
      overflow: hidden;
    }
    .act__inner { width: 100%; max-width: 980px; position: relative; z-index: 2; }
    .act__tag {
      font-family: var(--pixel);
      font-size: 12px;
      letter-spacing: .22em;
      opacity: .75;
      margin-bottom: 14px;
    }
    .act__title { font-family: var(--pixel); font-size: clamp(26px, 4.6vw, 46px); line-height: 1.2; letter-spacing: .02em; }
    .act__body { max-width: 56ch; margin-top: 14px; font-size: 16.5px; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--pixel);
      font-size: 15px;
      padding: 14px 24px;
      border: 3px solid var(--ink);
      box-shadow: 4px 4px 0 rgba(23,19,15,.35);
      cursor: pointer; text-decoration: none;
      background: var(--paper); color: var(--ink);
      transition: transform .12s steps(2);
    }
    .btn:hover { transform: translate(-2px,-2px); }
    .btn--solid { background: var(--alert); color: #fff; border-color: #7a1f12; }

    /* ----- 第一幕 Hero：晴空出生点 ----- */
    .act--hero {
      background: linear-gradient(180deg, var(--sky) 0 82%, var(--mist) 82% 90%, var(--grass) 90% 100%);
    }
    .act--hero .act__tag { color: var(--ink); }
    .act--hero .hero-name { color: var(--alert); }
    /* 不水平的草地边：手绘地图感 */
    .act--hero::after {
      content: "";
      position: absolute;
      left: -10%; right: -10%; bottom: -2px;
      height: 46px;
      background:
        linear-gradient(135deg, transparent 0 14px, var(--grass) 14px 100%) left/22px 100% repeat-x,
        linear-gradient(45deg,  var(--grass) 0 14px, transparent 14px 100%) left/22px 100% repeat-x;
      opacity: 1;
    }
    .act--hero .hero-dlg {
      max-width: 46ch;
      background: var(--paper);
      border: 3px solid var(--ink);
      box-shadow: 6px 6px 0 rgba(23,19,15,.4);
      padding: 22px 24px;
      transform: rotate(-.6deg);
    }

    /* ----- 第二幕 能力区：草地调查现场 ----- */
    .act--grass {
      background:
        linear-gradient(176deg,
          var(--mist) 0 8%,
          var(--sky) 8% 11%,
          var(--road) 11% 15%,
          var(--grass) 15% 100%);
    }
    .act--grass .act__title { color: #eaffdc; text-shadow: 0 3px 0 rgba(0,0,0,.35); }
    .ability-scene {
      display: grid;
      grid-template-columns: 1.3fr .7fr;
      grid-template-rows: 190px 160px;
      gap: 14px;
      margin-top: 22px;
    }
    .obj {
      border: 3px solid var(--ink);
      box-shadow: 5px 5px 0 rgba(23,19,15,.35);
      background: var(--paper);
      padding: 18px 20px;
      display: flex; flex-direction: column; justify-content: center;
      position: relative;
      transition: transform .45s cubic-bezier(.16,1.35,.35,1);
      will-change: transform;
    }
    .obj:hover { transform: translateY(-3px) rotate(0deg) !important; }
    .obj--system { grid-row: 1/3; transform: rotate(-1.3deg); background: #fdf8dc; }
    .obj--narrative { transform: rotate(1deg); }
    .obj--level { transform: rotate(-1.8deg); }
    .obj__num { font-family: var(--pixel); font-size: 44px; line-height: 1; }
    .obj__name { font-family: var(--pixel); font-size: 15px; letter-spacing: .06em; margin-top: 8px; }
    .obj__ev { font-size: 13.5px; opacity: .75; margin-top: 6px; }
    .obj__bar {
      height: 10px; border: 2px solid var(--ink); background: #fff; margin-top: 12px; overflow: hidden;
    }
    .obj__bar i { display: block; height: 100%; width: 0; transition: width 1.1s cubic-bezier(.2,.9,.3,1); background: repeating-linear-gradient(90deg, var(--alert) 0 8px, #a91f0f 8px 10px); }
    /* 能力偶发事件文本 */
    .obj .event-text {
      position: absolute;
      left: 8px; bottom: -14px;
      font-family: var(--pixel); font-size: 11px;
      background: var(--road); border: 2px solid var(--ink);
      padding: 2px 8px; opacity: 0; transform: translateY(4px);
      transition: all .3s;
      pointer-events: none;
      white-space: nowrap;
    }
    .obj.ev-on .event-text { opacity: 1; transform: none; }

    /* ----- 第三幕 Demo：精神异常区（唯一大面积暗场） ----- */
    .act--battle {
      background: var(--ink);
      color: var(--paper);
      align-items: stretch;
      display: block;
    }
    .act--battle .sticky-zone {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    .warp-zone {
      position: absolute;
      inset: 0;
    }
    .warp-zone canvas { width: 100%; height: 100%; display: block; opacity: .5; mix-blend-mode: screen; }
    .battle-card {
      position: relative;
      z-index: 2;
      width: min(620px, 88vw);
      margin: 0 auto;
      border: 4px solid var(--grape);
      background: rgba(23,19,15,.55);
      padding: 30px 34px;
      box-shadow: 0 0 40px rgba(122,90,200,.5), 12px 12px 0 rgba(0,0,0,.5);
    }
    .battle-card .act__title { color: #fff; text-shadow: 0 0 18px var(--grape); }
    .battle-card .battle-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 22px; }
    .btn--battle { background: var(--alert); color: #fff; border-color: #7a1f12; }
    .btn--ghost { background: transparent; color: var(--paper); border-color: var(--paper); box-shadow: none; }

    /* ----- 第四幕 证据库：晚霞公路 + 档案室 ----- */
    .act--road {
      background: linear-gradient(180deg, var(--peach) 0 74%, var(--road) 74% 100%);
      align-items: flex-start;
      padding-top: 110px;
    }
    .signs {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-top: 24px;
    }
    .sign {
      display: flex;
      align-items: baseline;
      gap: 14px;
      background: var(--wood);
      color: var(--paper);
      border: 3px solid var(--ink);
      box-shadow: 5px 5px 0 rgba(23,19,15,.35);
      padding: 14px 22px;
      max-width: 560px;
      transform: rotate(-.3deg);
      text-decoration: none;
    }
    .sign:nth-child(2) { margin-left: 70px; transform: rotate(.4deg); }
    .sign:nth-child(3) { margin-left: 140px; transform: rotate(-.2deg); }
    .sign .sign__name { font-family: var(--pixel); font-size: 18px; }
    .sign .sign__type { font-size: 13px; opacity: .8; margin-left: auto; }

    .act--archive {
      background: var(--grape);
      color: var(--paper);
    }
    .file {
      background: var(--paper); color: var(--ink);
      border: 3px solid var(--ink);
      box-shadow: 6px 6px 0 rgba(0,0,0,.35);
      padding: 18px 22px;
      margin-top: 14px;
      max-width: 640px;
      display: flex; gap: 12px; align-items: baseline;
      text-decoration: none;
    }
    .file .file__no { font-family: var(--pixel); color: var(--grape); }
    .file .file__title { font-weight: 700; }

    /* ----- 第五幕 入队：夜幕营火 ----- */
    .act--camp {
      background: var(--ink);
      color: var(--paper);
      text-align: center;
      flex-direction: column;
    }
    .act--camp .camp-star {
      font-size: 12px; color: var(--road);
      letter-spacing: 14px;
      margin-bottom: 16px;
    }
    .act--camp .fire { font-size: 60px; line-height: 1; filter: drop-shadow(0 0 14px rgba(240,82,61,.8)); }
    .act--camp .camp-btns { display: flex; gap: 16px; margin-top: 28px; flex-wrap: wrap; justify-content: center; }

    /* 小屏兜底 */
    @media (max-width: 860px) {
      .ability-scene { grid-template-columns: 1fr; grid-template-rows: none; }
      .obj--system { grid-row: auto; }
      .world-route { display: none; }
      .act { padding-left: 24px; }
      .sign:nth-child(2), .sign:nth-child(3) { margin-left: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
      .obj__bar i { width: 100% !important; }
    }
  </style>
</head>
<body>
  <!-- 贯穿路线 -->
  <div class="world-route" aria-hidden="true">
    <svg viewBox="0 0 46 900" preserveAspectRatio="none">
      <path id="route-base" class="route-base" d="M 23 4 C 36 120, 8 200, 23 300 S 40 430, 16 520 S 30 720, 23 896" />
      <path id="route-ink" class="route-ink" d="M 23 4 C 36 120, 8 200, 23 300 S 40 430, 16 520 S 30 720, 23 896" />
      <path id="route-done" class="route-done" d="M 23 4 C 36 120, 8 200, 23 300 S 40 430, 16 520 S 30 720, 23 896" />
    </svg>
    <div class="token" id="token">明</div>
    <span class="stop-name" id="stop-name"></span>
