---
interface TimelineItem {
  period: string;
  title: string;
  detail: string;
  tags?: string[];
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="relative space-y-10 border-l border-neutral-700 pl-8">
  {
    items.map((item) => (
      <li class="relative">
        <span class="absolute -left-[2.5rem] top-1.5 h-3 w-3 rounded-full bg-amber outline outline-4 outline-neutral-950" />
        <p class="text-xs font-medium text-green-text">{item.period}</p>
        <h3 class="mt-1 font-semibold text-neutral-100">{item.title}</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-neutral-400">{item.detail}</p>
        {
          item.tags && item.tags.length > 0 && (
            <div class="mt-2 flex flex-wrap gap-2">
              {item.tags.map((tag) => (
                <span class="rounded-full bg-neutral-800 px-2.5 py-0.5 text-xs text-neutral-300">{tag}</span>
              ))}
            </div>
          )
        }
      </li>
    ))
  }
</ol>