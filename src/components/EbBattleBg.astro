---
// EarthBound 战斗背景（earthbound-battle-backgrounds）
// 由于游戏即将部署上线，背景只绘制静态一帧，不再启动动画循环；
// 懒加载：进入视口才动态 import；加载失败时删除 canvas，由 .eb-battle__stage 暖色渐变兜底。
---
<canvas class="eb-battle__bg" aria-hidden="true"></canvas>

<script>
  (() => {
    const canvas = document.querySelector('.eb-battle__bg');
    if (!canvas) return;

    async function start() {
      try {
        const { Engine, BackgroundLayer } = await import('earthbound-battle-backgrounds');
        const engine = new Engine(
          [new BackgroundLayer(154), new BackgroundLayer(298)],
          { canvas }
        );
        // 静态一帧：镜像 animate() 的单帧计算，但不启动 rAF 循环
        engine.layers[0].entry && !engine.layers[1].entry && ((engine.alpha[0] = 1), (engine.alpha[1] = 0));
        !engine.layers[0].entry && engine.layers[1].entry && ((engine.alpha[0] = 0), (engine.alpha[1] = 1));
        const ctx = canvas.getContext('2d');
        ctx.imageSmoothingEnabled = false;
        canvas.width = 256;
        canvas.height = 224;
        const img = ctx.getImageData(0, 0, canvas.width, canvas.height);
        let data = img.data;
        engine.layers.forEach((layer, i) => {
          data = layer.overlayFrame(data, engine.aspectRatio, engine.tick, engine.alpha[i], i === 0);
        });
        img.data.set(data);
        ctx.putImageData(img, 0, 0);
      } catch (err) {
        canvas.remove();
      }
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            io.disconnect();
            start();
          }
        },
        { rootMargin: '240px 0px' }
      );
      io.observe(canvas);
    } else {
      start();
    }
  })();
</script>
