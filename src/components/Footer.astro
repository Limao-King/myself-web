---
import { siteConfig } from '../site.config';
---

<footer class="py-5 md:py-8">
  <div class="mx-auto max-w-5xl px-6">
    <div class="flex flex-col items-center gap-2 text-center text-sm text-neutral-400">
      <p>
        © {new Date().getFullYear()} {siteConfig.name} ·
        <a href={`mailto:${siteConfig.email}`} class="link-underline inline-flex min-h-[44px] items-center transition-colors hover:text-green-text md:min-h-0">{siteConfig.email}</a>
        {siteConfig.github !== 'https://github.com/yourname' && (
          <>
            {' '}· <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="link-underline inline-flex min-h-[44px] items-center transition-colors hover:text-green-text md:min-h-0">GitHub</a>
          </>
        )}
      </p>
      <a href="#main" class="link-underline inline-flex min-h-[44px] items-center font-pixel text-xs text-neutral-500 transition-colors hover:text-green-text md:min-h-0">▲ 返回顶部</a>
    </div>
  </div>
</footer>