---
import { siteConfig } from '../site.config';
---
<footer class="pf-footer" id="contact">
  <div class="pf-container pf-footer__inner">
    <div>
      <p class="pf-footer__eyebrow">小镇邮局</p>
      <strong>有些冒险，始于一句「你好」。</strong>
      <div class="pf-footer__contact"><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a><button type="button" data-copy-email data-email={siteConfig.email} hidden>复制邮箱</button><span data-copy-status role="status"></span></div>
    </div>
    <div class="pf-footer__links">
      <a href={`mailto:${siteConfig.email}`}>发邮件 ↗</a>
      <a href={siteConfig.resumeUrl} target="_blank" rel="noopener">下载简历 ↗</a>
      <a href={siteConfig.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </div>
  <div class="pf-container pf-footer__bottom"><span>© {new Date().getFullYear()} {siteConfig.name}</span><a href="#main">回到顶部 ↑</a></div>
</footer>
<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyStatus = document.querySelector('[data-copy-status]');
  if (copyButton && navigator.clipboard?.writeText) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyButton.dataset.email ?? '');
        if (copyStatus) copyStatus.textContent = '邮箱已复制';
      } catch {
        if (copyStatus) copyStatus.textContent = '请选中邮箱地址手动复制';
      }
    });
  }
</script>
