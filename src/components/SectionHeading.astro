---
interface Props {
  title: string;
  description?: string;
  moreHref?: string;
  moreText?: string;
  /** 标题级别：页面主标题用 h1，板块标题用 h2（默认 h2） */
  as?: 'h1' | 'h2';
}

const { title, description, moreHref, moreText = '查看全部 →', as = 'h2' } = Astro.props;
const Tag = as as 'h1';
const headingClass = `flex items-center gap-3 text-2xl font-bold text-neutral-100${as === 'h1' ? ' font-body' : ''}`;
---

<div class="mb-8 flex items-end justify-between gap-6">
  <div class="min-w-0">
    <Tag class={headingClass}>
      <span
        class="inline-block h-4 w-1.5 shrink-0 bg-violet-500 [box-shadow:2px_2px_0_rgba(38,32,22,0.18)]"
        aria-hidden="true"
      ></span>
      {title}
    </Tag>
    {description && <p class="mt-2 pl-[1.125rem] text-sm text-neutral-400">{description}</p>}
  </div>
  {moreHref && (
    <a
      href={moreHref}
      class="link-underline shrink-0 text-sm font-medium text-green-text transition-colors hover:text-[#b06e14]"
    >
      {moreText}
    </a>
  )}
</div>
