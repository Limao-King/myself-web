---
interface Props {
  href: string;
  title: string;
  meta?: string;
  summary?: string;
  tags?: string[];
  /** 封面图（public/ 下路径），如 /images/projects/xxx.jpg */
  cover?: string;
  /** 无封面时的像素占位文案（如项目类型） */
  coverFallback?: string;
}

const { href, title, meta, summary, tags = [], cover, coverFallback } = Astro.props;
---

<a href={href} class="eb-card group relative flex flex-col overflow-hidden">
  {
    cover ? (
      <img
        src={cover}
        alt={`${title} 封面`}
        loading="lazy"
        class="eb-card__cover transition-transform duration-300 group-hover:scale-[1.03]"
      />
    ) : coverFallback ? (
      <div class="eb-card__fallback">
        <span class="font-pixel text-sm text-[#3a6920]">{coverFallback}</span>
      </div>
    ) : null
  }

  <div class="flex flex-1 flex-col p-5">
    <!-- 右上角提示箭头（悬停出现，提示可点击） -->
    <span class="eb-card__arrow" aria-hidden="true">→</span>

    {meta && <p class="eb-card__meta">{meta}</p>}
    <h3 class="eb-card__title">{title}</h3>
    {summary && <p class="eb-card__sum">{summary}</p>}
    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="eb-card__tag">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</a>

<style>
  /* 与首页「图鉴」卡同一套语言：奶油底 + 棕描边 + 硬阴影
     （替代原先的 rounded-xl + violet 悬停——那套是现代 SaaS 文档卡语言，不在 EB 色板内） */
  .eb-card {
    background: #f4ecd8;
    border: 2px solid #8a6a3a;
    border-radius: 6px;
    box-shadow: 3px 3px 0 rgba(38, 32, 22, 0.14);
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease;
  }
  .eb-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 rgba(38, 32, 22, 0.2);
    background: #faf3e2;
  }
  .eb-card:active { transform: translate(1px, 1px); box-shadow: none; }

  .eb-card__cover {
    width: 100%;
    border-bottom: 2px solid rgba(38, 32, 22, 0.15);
    image-rendering: pixelated;
  }
  .eb-card__fallback {
    display: flex;
    height: 8rem;
    align-items: center;
    justify-content: center;
    border-bottom: 2px solid rgba(38, 32, 22, 0.15);
    background: #e3eec9;
  }
  .eb-card__arrow {
    position: absolute;
    right: 1.1rem;
    top: 1.1rem;
    font-family: "FusionPixel", var(--font-sans);
    color: #9a5a1e;
    opacity: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .eb-card:hover .eb-card__arrow { opacity: 1; transform: translateX(2px); }

  .eb-card__meta {
    padding-right: 1.5rem;
    font-family: "FusionPixel", var(--font-sans);
    font-size: 0.72rem;
    color: #66543c;
  }
  .eb-card__title {
    margin-top: 0.5rem;
    font-family: "FusionPixel", var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    color: #2b2418;
    transition: color 0.12s ease;
  }
  .eb-card:hover .eb-card__title { color: #9a5a1e; }
  .eb-card__sum {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.7;
    color: #4a3f30;
  }
  .eb-card__tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    background: #1f140d;
    color: #f5f5db;
    border-radius: 4px;
    font-family: "FusionPixel", var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
  }
</style>
