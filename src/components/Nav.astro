---
import { siteConfig } from '../site.config';

interface Props {
  /** 当前页是否 EB 主题（决定是否显示「经典视图」开关） */
  eb?: boolean;
}
const { eb = false } = Astro.props;

const links = [
  { href: '/', label: '首页' },
  { href: '/projects/', label: '项目' },
  { href: '/game-history/', label: '游戏经历' },
  { href: '/docs/', label: '策划文档' },
  { href: '/about/', label: '关于我' },
];

const isActive = (href: string) =>
  href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---

<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="nav-brand" aria-label={`${siteConfig.name}作品集首页`}>
      <span class="nav-brand__char" role="img" aria-label="像素角色头像"></span>
      <span class="nav-brand__copy">
        <strong>{siteConfig.name}</strong>
        <small>GAME DESIGN PORTFOLIO</small>
      </span>
    </a>
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'link-underline font-pixel rounded-md px-3 py-1.5 text-sm transition-colors',
                isActive(link.href) ? 'font-bold' : '',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="ml-2 flex items-center">
        <a
          href={siteConfig.resumeUrl}
          target="_blank"
          class="rpgui-button golden nav-resume"
        >
          <p>简历</p>
        </a>
      </li>
    </ul>

    <!-- 移动端菜单按钮 -->
    <button
      id="nav-toggle"
      type="button"
      class="ml-auto flex h-10 w-10 items-center justify-center rounded-lg text-[var(--nav-ink)] transition-colors hover:bg-[var(--nav-link-active)]/10 md:hidden"
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </nav>

  <!-- 移动端下拉菜单 -->
  <div id="mobile-menu" class="hidden border-t-2 border-[#262016] bg-[var(--nav-bg,#b4c586)] px-6 py-4 md:hidden">
    <ul class="flex flex-col gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block font-pixel rounded-lg px-3 py-2.5 text-sm transition-colors',
                isActive(link.href) ? 'bg-[#262016]/10 font-bold' : 'hover:bg-[#262016]/8',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 flex justify-center">
        <a
          href={siteConfig.resumeUrl}
          target="_blank"
          class="rpgui-button golden nav-resume"
        >
          <p>下载简历</p>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  function initNav() {
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu || toggle.dataset.bound) return;
    toggle.dataset.bound = '1';

    const setOpen = (open) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (event) => {
      if (event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
