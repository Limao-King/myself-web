---
import { siteConfig } from '../site.config';
const path = Astro.url.pathname;
const items = [
  { href: '/projects/', label: '项目案例' },
  { href: '/docs/', label: '策划文档' },
  { href: '/game-history/', label: '游戏经历' },
  { href: '/about/', label: '关于我' },
];
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class="pf-header">
  <div class="pf-header__inner">
    <a href="/" class="pf-brand" aria-label={`${siteConfig.name}作品集首页`}>
      <span class="pf-brand__avatar" aria-hidden="true"><img src="/images/characters/tanuki.svg" alt="" width="36" height="36" /></span>
      <span class="pf-brand__copy"><strong>{siteConfig.name}</strong><small>游戏系统策划 · 作品集</small></span>
    </a>
    <nav class="pf-nav" aria-label="主导航">
      <div class="pf-nav__signboard">
        <a href="/" aria-current={active('/') ? 'page' : undefined}>首页</a>
        {items.map((item) => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </div>
      <a class="pf-nav__resume" href={siteConfig.resumeUrl} target="_blank" rel="noopener">下载简历 <span aria-hidden="true">↗</span></a>
    </nav>
    <details class="pf-mobile-menu">
      <summary aria-label="打开导航菜单"><span></span><span></span><span></span></summary>
      <nav aria-label="手机导航">
        <a href="/" aria-current={active('/') ? 'page' : undefined}>首页</a>
        {items.map((item) => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
        <a href={siteConfig.resumeUrl} target="_blank" rel="noopener">下载简历 ↗</a>
      </nav>
    </details>
  </div>
</header>

<style>
  :global(.pf-site) .pf-header {
    background: #f5f1dc;
    border-bottom: 1px solid #344431;
    box-shadow: 0 3px 0 #a98d58;
    backdrop-filter: none;
  }
  :global(.pf-site) .pf-header__inner { gap: 18px; }
  :global(.pf-site) .pf-nav { gap: 12px; }
  :global(.pf-site) .pf-nav__signboard {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    background: #f7efd3;
    border: 1px solid #9b8052;
    box-shadow: 3px 3px 0 rgba(69,57,39,.17);
  }
  :global(.pf-site) .pf-nav__signboard a {
    position: relative;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 0;
    transition: background-color .15s ease, transform .15s ease;
  }
  :global(.pf-site) .pf-nav__signboard a:hover {
    background: #dfe7c4;
    transform: translateY(-1px);
  }
  :global(.pf-site) .pf-nav__signboard a[href="/about/"] { transform: rotate(1deg); }
  :global(.pf-site) .pf-nav__signboard a[href="/about/"]:hover { transform: rotate(1deg) translateY(-1px); }
  :global(.pf-site) .pf-nav__signboard a[aria-current="page"] {
    padding-left: 22px;
    background: #dfe7c4;
    box-shadow: inset 0 -2px #9b5038;
  }
  :global(.pf-site) .pf-nav__signboard a[aria-current="page"]::after {
    content: "›";
    position: absolute;
    top: 50%;
    right: auto;
    bottom: auto;
    left: 8px;
    width: auto;
    height: auto;
    background: none;
    color: #a44732;
    font-size: 1.05rem;
    line-height: 1;
    transform: translateY(-55%);
  }
  :global(.pf-site) .pf-nav .pf-nav__resume {
    min-height: 42px;
    margin-left: 0;
    padding: 0 15px;
    border: 1px solid #594a2d;
    border-radius: 0;
    background: #e9c95f;
    box-shadow: 3px 3px 0 rgba(69,57,39,.19);
    transition: background-color .15s ease, transform .15s ease;
  }
  :global(.pf-site) .pf-nav .pf-nav__resume:hover { background: #f1d97f; transform: translateY(-1px); }
  :global(.pf-site) .pf-header a:focus-visible,
  :global(.pf-site) .pf-mobile-menu summary:focus-visible { outline-color: #a44732; outline-offset: 3px; }
  :global(.pf-site) .pf-mobile-menu summary {
    border: 1px solid #594a2d;
    border-radius: 0;
    background: #f7efd3;
    box-shadow: 3px 3px 0 rgba(69,57,39,.17);
  }
  :global(.pf-site) .pf-mobile-menu summary span { height: 3px; background: #344431; }
  :global(.pf-site) .pf-mobile-menu[open] summary { background: #dfe7c4; }
  :global(.pf-site) .pf-mobile-menu nav {
    top: calc(100% + 9px);
    padding: 8px;
    background: #f7efd3;
    border: 1px solid #826c47;
    box-shadow: 4px 4px 0 rgba(46,53,39,.17);
  }
  :global(.pf-site) .pf-mobile-menu nav a {
    min-height: 44px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #d0c29e;
    transition: background-color .15s ease;
  }
  :global(.pf-site) .pf-mobile-menu nav a:last-child {
    margin-top: 6px;
    border: 1px solid #594a2d;
    background: #e9c95f;
  }
  :global(.pf-site) .pf-mobile-menu nav a:hover,
  :global(.pf-site) .pf-mobile-menu nav a[aria-current="page"] { background: #dfe7c4; }
  :global(.pf-site) .pf-mobile-menu nav a[aria-current="page"] { border-left: 3px solid #a44732; padding-left: 11px; }
  :global(.pf-site) .pf-mobile-menu nav a:last-child:hover { background: #f1d97f; }
  @media (max-width: 900px) {
    :global(.pf-site) .pf-header .pf-nav { display: none; }
    :global(.pf-site) .pf-header .pf-mobile-menu { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.pf-site) .pf-header *,
    :global(.pf-site) .pf-header *::before,
    :global(.pf-site) .pf-header *::after { transition: none; }
  }
</style>
