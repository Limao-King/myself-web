<script>
  // Local time supplies the atmosphere without adding another control to the map.
  const updateTownTime = () => {
    const hour = new Date().getHours();
    document.documentElement.dataset.townTime = hour >= 17 || hour < 6 ? 'dusk' : 'day';
  };
  updateTownTime();
  window.setInterval(updateTownTime, 60000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) updateTownTime(); });
</script>
