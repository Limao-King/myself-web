---
import '../styles/misans-fontfaces.css';
import '../styles/global.css';
/* 已移除 `import '../styles/eb.css'`（51KB EB 主题样式，轻量审查结论：全域死代码）。
   依据：没有任何页面传 theme="eb"/"eb2" ⇒ `.eb-theme/.eb2-theme` 作用域的 251 条规则永不匹配；
   主页面/预览页 `eb-` 类命中为 0（仅 3 个零引用组件还写着 .eb-*）；外部仍在消费的变量由
   portfolio.css 提供（--eb-frame/--eb-red）或已有同值兜底（--eb-frame-w 默认 3px）。
   文件保留在 src/styles/eb.css，若要启用 EB 主题页面，把上面这行 import 加回即可。 */
import '../styles/portfolio.css';
import '../styles/portfolio-refinements.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Existing preview routes can still request their historical theme. */
  theme?: 'paper' | 'eb' | 'eb2';
  panel?: boolean;
  footer?: boolean;
}

const { title, description, ogImage = '/images/projects/fairytale/01-title.jpg', theme, footer = true } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · 游戏系统策划作品集`;
const pageDescription = description ?? siteConfig.description;
---

<!doctype html>
<html lang="zh-CN" class:list={['pf-site', Astro.url.pathname === '/' ? 'pf-homepage' : 'pf-subpage', theme === 'eb' && 'eb-theme', theme === 'eb2' && 'eb2-theme']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#e6e4c8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteConfig.siteUrl}${Astro.url.pathname}`} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteConfig.siteUrl}${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="pf-skip" href="#main">跳到主要内容</a>
    <Nav />
    <main id="main" class="pf-main"><slot /></main>
    <slot name="floating" />
    {footer && <Footer />}

    <script is:inline>
      // 维持现有只写访问记录契约；不读取访问日志。
      (() => {
        if (['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)) return;
        const endpoint = 'https://play.limao.site/hit';
        if (!navigator.sendBeacon && !window.fetch) return;
        try {
          const body = JSON.stringify({
            path: location.pathname,
            ref: document.referrer ? document.referrer.split('?')[0].slice(0, 256) : '',
            lang: navigator.language || '',
            sw: window.screen ? window.screen.width : null,
            vw: window.innerWidth || null,
            tz: (Intl.DateTimeFormat().resolvedOptions() || {}).timeZone || '',
            device: matchMedia('(pointer:coarse)').matches ? 'touch' : 'mouse',
          });
          if (navigator.sendBeacon) navigator.sendBeacon(endpoint, new Blob([body], { type: 'text/plain' }));
          else fetch(endpoint, { method: 'POST', body, keepalive: true, headers: { 'Content-Type': 'text/plain' } }).catch(() => {});
        } catch {
          // 记录失败不影响浏览。
        }
      })();
    </script>
  </body>
</html>
